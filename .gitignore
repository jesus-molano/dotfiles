# Fish runtime state
fish/.config/fish/fish_variables

# Micro plugin runtime
micro/.config/micro/buffers/
micro/.config/micro/plugins/

# Font cache
fonts/.local/share/fonts/.uuid

# Codex runtime state. Version only durable, secret-free configuration.
!codex/.codex/
codex/.codex/*
!codex/.codex/AGENTS.md
!codex/.codex/config.template.toml
!codex/.codex/fast.config.toml
!codex/.codex/deep.config.toml
!codex/.codex/agents/
codex/.codex/agents/*
!codex/.codex/agents/reviewer-web.toml
!codex/.codex/agents/reviewer-linux.toml
!codex/.codex/agents/reviewer-spec.toml
!codex/.codex/agents/reviewer-standards.toml

# Política ExecPolicy específica de este repositorio (la exclusión global de
# ~/.codex no debe ocultar la capa local confiable).
!/.codex/
!/.codex/rules/
!/.codex/rules/host-audit.rules

# Secrets and local 1Password reference files (at any depth).
.env
.env.*
!.env.example
!.env.*.example
!.env.template
!.env.*.template

# OS generated
.DS_Store
*.swp
*.swo
*~
