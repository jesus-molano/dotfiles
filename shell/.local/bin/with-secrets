#!/usr/bin/env bash
set -euo pipefail

if (($# == 0)); then
	printf '%s\n' 'Uso: with-secrets <comando> [argumentos...]' >&2
	exit 2
fi
command -v op >/dev/null 2>&1 || {
	printf '%s\n' '1Password CLI no está instalado.' >&2
	exit 1
}

env_file="$HOME/.env.op"
[[ -f "$env_file" ]] || {
	printf 'No existe el archivo local de referencias: %s\n' "$env_file" >&2
	exit 1
}

exec op run --env-file "$env_file" -- "$@"
