#!/usr/bin/env bash
set -euo pipefail

list_games() {
	printf '%s\n' \
		$'steam\tSteam' \
		$'heroic\tHeroic Games Launcher' \
		$'lutris\tLutris' \
		$'faugus\tFaugus Launcher' \
		$'scx_manager\tSCX Manager - solo para pruebas medidas'
}

run_game() {
	local selection=${1%%[[:space:]]*}
	case "$selection" in
	steam) exec hypr-gaming ;;
	heroic) exec uwsm app -- heroic ;;
	lutris) exec uwsm app -- lutris ;;
	faugus) exec uwsm app -- faugus-launcher ;;
	scx_manager) exec uwsm app -- scx-manager ;;
	*) return 2 ;;
	esac
}

case "${1:-}" in
list) list_games ;;
run) [[ -n "${2:-}" ]] && run_game "$2" ;;
*)
	printf '%s\n' 'Uso: gaming-launcher {list|run SELECCIÓN}' >&2
	exit 2
	;;
esac
