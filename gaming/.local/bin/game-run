#!/usr/bin/env bash
set -euo pipefail

usage() {
	printf '%s\n' \
		'Uso: game-run [--hud] [--gamescope] [--bench NOMBRE] [--duration SEGUNDOS] [--dry-run] [--] COMANDO [ARGUMENTOS...]'
}

hud=false
use_gamescope=false
dry_run=false
benchmark_name=''
benchmark_duration=120

while (($#)); do
	case "$1" in
	--hud)
		hud=true
		;;
	--gamescope)
		use_gamescope=true
		;;
	--dry-run)
		dry_run=true
		;;
	--bench)
		(($# >= 2)) || {
			printf '%s\n' 'Falta el nombre del benchmark.' >&2
			exit 2
		}
		benchmark_name=$2
		shift
		;;
	--duration)
		(($# >= 2)) || {
			printf '%s\n' 'Falta la duración del benchmark.' >&2
			exit 2
		}
		benchmark_duration=$2
		shift
		;;
	--help | -h)
		usage
		exit 0
		;;
	--)
		shift
		break
		;;
	-*)
		printf 'Opción desconocida: %s\n' "$1" >&2
		usage >&2
		exit 2
		;;
	*)
		break
		;;
	esac
	shift
done

if (($# == 0)); then
	printf '%s\n' 'Falta el comando del juego.' >&2
	usage >&2
	exit 2
fi

if [[ -n "$benchmark_name" ]]; then
	[[ "$benchmark_name" =~ ^[[:alnum:]_.-]+$ && "$benchmark_name" != . && "$benchmark_name" != .. ]] || {
		printf '%s\n' 'El nombre admite letras, números, punto, guion y guion bajo; no puede ser uno o dos puntos.' >&2
		exit 2
	}
	if [[ ! "$benchmark_duration" =~ ^[0-9]+$ ]] ||
		((benchmark_duration < 10 || benchmark_duration > 3600)); then
		printf '%s\n' 'La duración debe ser un entero entre 10 y 3600 segundos.' >&2
		exit 2
	fi
	hud=true
	benchmark_root="${XDG_STATE_HOME:-$HOME/.local/state}/gaming/benchmarks/$benchmark_name"
	benchmark_run="$benchmark_root/$(date +%Y%m%d-%H%M%S)"
	benchmark_config="autostart_log=1,log_duration=$benchmark_duration,log_interval=100,output_folder=$benchmark_run,permit_upload=0,benchmark_percentiles=97+AVG+1+0.1"
fi

game_command=("$@")
launch_command=(game-performance)

if [[ "$use_gamescope" == true ]]; then
	launch_command+=(gamescope -W 1920 -H 1080 -r 75 -f)
	if [[ "$hud" == true ]]; then
		launch_command+=(--mangoapp)
	fi
	launch_command+=(-- "${game_command[@]}")
elif [[ "$hud" == true ]]; then
	launch_command+=(mangohud "${game_command[@]}")
else
	launch_command+=("${game_command[@]}")
fi

if [[ "$dry_run" == true ]]; then
	if [[ -n "$benchmark_name" ]]; then
		printf 'MANGOHUD_CONFIG=%q\n' "$benchmark_config"
		printf 'Benchmark: %q\n' "$benchmark_run"
	fi
	printf 'Comando:'
	printf ' %q' "${launch_command[@]}"
	printf '\n'
	exit 0
fi

require_command() {
	command -v "$1" >/dev/null || {
		printf 'No se encuentra el comando requerido: %s\n' "$1" >&2
		exit 127
	}
}

require_command game-performance
if [[ "$use_gamescope" == true ]]; then
	require_command gamescope
elif [[ "$hud" == true ]]; then
	require_command mangohud
fi

if [[ -n "$benchmark_name" ]]; then
	mkdir -p -- "$benchmark_run"
	export MANGOHUD_CONFIG="${MANGOHUD_CONFIG:+$MANGOHUD_CONFIG,}$benchmark_config"
	{
		printf 'fecha=%s\n' "$(date --iso-8601=seconds)"
		printf 'kernel=%s\n' "$(uname -r)"
		printf 'programa=%s\n' "${game_command[0]##*/}"
		printf 'duracion=%s\n' "$benchmark_duration"
		nvidia-smi --query-gpu=name,driver_version --format=csv,noheader 2>/dev/null || true
	} >"$benchmark_run/metadata.txt"
	printf 'Benchmark MangoHud: %s\n' "$benchmark_run"
fi

exec "${launch_command[@]}"
