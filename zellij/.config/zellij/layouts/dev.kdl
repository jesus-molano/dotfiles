layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="compact-bar"
        }
        children
    }

    // ChatGPT Community is the main work app. Zellij starts with one useful
    // shell and only creates panes or tabs when requested with Alt+Z.
    tab name="work" focus=true {
        pane name="shell" focus=true
    }
}
