# Font
font-family = JetBrainsMono Nerd Font
font-size = 12

# Window
window-padding-x = 10
window-padding-y = 10
window-decoration = false
background-opacity = 0.95

# Behavior
# Ghostty measures this value in bytes; 10 MB is ample for normal development
# without retaining an unbounded amount of terminal output.
scrollback-limit = 10000000
shell-integration = detect
confirm-close-surface = true

# Cursor
cursor-style = block
cursor-style-blink = false

# Theme generated by Noctalia at ~/.config/ghostty/themes/noctalia.
theme = noctalia
