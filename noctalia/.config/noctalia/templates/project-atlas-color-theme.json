    "descriptionForeground": "{{colors.on_surface_variant.default.hex}}",
    "errorForeground": "{{colors.error.default.hex}}",
    "icon.foreground": "{{colors.on_surface_variant.default.hex}}",
    "selection.background": "{{colors.terminal_selection_bg.default.hex}}",
    "textLink.foreground": "{{colors.secondary.default.hex}}",
    "textLink.activeForeground": "{{colors.primary.default.hex}}",
    "button.background": "{{colors.primary.default.hex}}",
    "button.foreground": "{{colors.on_primary.default.hex}}",
    "button.hoverBackground": "{{colors.primary_container.default.hex}}",
    "dropdown.background": "{{colors.surface_variant.default.hex}}",
    "dropdown.border": "{{colors.outline.default.hex}}",
    "input.background": "{{colors.terminal_background.default.hex}}",
    "input.border": "{{colors.outline.default.hex}}",
