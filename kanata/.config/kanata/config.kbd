;; Caps Lock: tap = Escape, hold = Hyper (Ctrl+Alt+Super+Shift).
(defcfg
  process-unmapped-keys yes
)

;; Keep the source list intentionally small. Unmapped keys pass through.
(defsrc
  caps a s d f h j k l
)

(defalias
  ;; Preserve the timings from the previous desktop configuration.
  cap (tap-hold 150 200 esc (multi lctl lalt lmet lsft))
)

(deflayer base
  @cap a s d f h j k l
)
