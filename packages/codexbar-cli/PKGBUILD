# Maintainer: jesus-molano

pkgname=codexbar-cli
pkgver=0.55.1
pkgrel=1
pkgdesc='AI coding provider usage tracker CLI'
arch=('x86_64' 'aarch64')
url='https://github.com/steipete/CodexBar'
license=('MIT')
depends=('curl' 'gcc-libs' 'glibc' 'sqlite')

provides=('codexbar')
conflicts=('codexbar')

source=(
  'codexbar-wrapper'
  "LICENSE::https://raw.githubusercontent.com/steipete/CodexBar/v${pkgver}/LICENSE"
)
source_x86_64=("CodexBarCLI-v${pkgver}-linux-x86_64.tar.gz::https://github.com/steipete/CodexBar/releases/download/v${pkgver}/CodexBarCLI-v${pkgver}-linux-x86_64.tar.gz")
source_aarch64=("CodexBarCLI-v${pkgver}-linux-aarch64.tar.gz::https://github.com/steipete/CodexBar/releases/download/v${pkgver}/CodexBarCLI-v${pkgver}-linux-aarch64.tar.gz")

sha256sums=(
  '3e6ed8edf2a02cc9effc1c38a58c602fcb1213366acea67c2b94ec59b8e8941d'
  '14293556b79940745123d0160c71d27ed0e9fe9b8a848093f3ed78f4853caafe'
)
sha256sums_x86_64=('46f63ba203211d88b27597251d6656601768f974efc83fa200970e7b4d7a6b29')
sha256sums_aarch64=('650ac1f023a3ac0d74a18f8b0ba38976472ef47b56ecdbf67d36c1607e268888')

check() {
  [[ $(./CodexBarCLI --version) == "CodexBar ${pkgver}" ]]
  [[ $(<VERSION) == "${pkgver}" ]]
  [[ -f CodexBar_CodexBarCore.bundle/Info.plist ]]
}

package() {
  install -Dm755 CodexBarCLI "${pkgdir}/usr/lib/${pkgname}/codexbar"
  install -Dm644 VERSION "${pkgdir}/usr/lib/${pkgname}/VERSION"
  cp -a CodexBar_CodexBarCore.bundle "${pkgdir}/usr/lib/${pkgname}/"
  install -Dm755 codexbar-wrapper "${pkgdir}/usr/bin/codexbar"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
