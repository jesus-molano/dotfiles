[user]
	name = jesus-molano
	email = jessumolano@gmail.com
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIOiWj5OG9LuaQVD6MRVguuuP6oR6NyFCuNcRnhGuJtxS
[url "git@github.com:"]
	insteadOf = https://github.com/
[url "git@gist.github.com:"]
	insteadOf = https://gist.github.com/
[init]
	defaultBranch = main
[core]
	editor = nvim
	excludesfile = ~/.gitignore_global
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	hyperlinks = true
	syntax-theme = Project Atlas
[diff]
	tool = difftastic
	colorMoved = default
[difftool]
	prompt = false
[difftool "difftastic"]
	cmd = difft "$MERGED" "$LOCAL" "0000000" "100644" "$REMOTE" "0000000" "100644"
[pager]
	difftool = true
[merge]
	tool = nvimdiff
	conflictstyle = diff3
[rerere]
	enabled = true
[pull]
	rebase = true
[fetch]
	prune = true
[push]
	autoSetupRemote = true
[column]
	ui = auto
[branch]
	sort = -committerdate
[alias]
	st = status -sb
	co = checkout
	br = branch --sort=-committerdate
	ci = commit
	amend = commit --amend --no-edit
	unstage = reset HEAD --
	last = log -1 HEAD
	graph = log --oneline --graph --decorate --all -20
	dft = -c diff.external=difft diff
	dshow = -c diff.external=difft show --ext-diff
	dlog = -c diff.external=difft log --ext-diff
[commit]
	gpgsign = true
[gpg]
	format = ssh
[gpg "ssh"]
	program = /opt/1Password/op-ssh-sign
	allowedSignersFile = ~/.ssh/allowed_signers
