#!/usr/bin/env bash

set -u

audio_config="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/generated/audio.conf"
load_audio_config() {
	[[ -r "$audio_config" ]] || return 0
	local line key value
	while IFS= read -r line || [[ -n "$line" ]]; do
		[[ -z "$line" || "$line" == \#* ]] && continue
		IFS='=' read -r key value <<<"$line"
		case "$key" in
		DOTFILES_AUDIO_CARD|DOTFILES_AUDIO_BASE_PROFILE|DOTFILES_AUDIO_SECONDARY_PROFILE|DOTFILES_AUDIO_SINK_PREFIX|DOTFILES_AUDIO_BASE_SINK|DOTFILES_AUDIO_SECONDARY_SINK)
			[[ "$value" =~ ^[A-Za-z0-9_.:-]+$ && -z "${!key:-}" ]] && printf -v "$key" '%s' "$value"
			;;
		esac
	done <"$audio_config"
}
load_audio_config

readonly card="${DOTFILES_AUDIO_CARD:-}"
readonly base_profile="${DOTFILES_AUDIO_BASE_PROFILE:-}"
readonly right_profile="${DOTFILES_AUDIO_SECONDARY_PROFILE:-}"
readonly sink_prefix="${DOTFILES_AUDIO_SINK_PREFIX:-}"
readonly base_sink="${DOTFILES_AUDIO_BASE_SINK:-}"
readonly right_sink="${DOTFILES_AUDIO_SECONDARY_SINK:-}"

declare -a sinks=()
declare -a profiles=()
declare -a labels=()
if [[ -n "$card" && -n "$base_profile" && -n "$right_profile" && -n "$sink_prefix" &&
	-n "$base_sink" && -n "$right_sink" ]]; then
	sinks=("$base_sink" "$right_sink")
	profiles=("$base_profile" "$right_profile")
	labels=('HDMI' 'HDMI 2 (monitor derecho)')
fi

notify() {
	noctalia msg notification-show 'Audio' -- "$1" 2>/dev/null || true
}

move_streams() {
	local target_sink=$1
	local target_id
	target_id=$(pactl list short sinks 2>/dev/null |
		awk -v sink="$target_sink" '$2 == sink { print $1; exit }')

	while read -r input_id current_sink_id _; do
		if [[ -n "$input_id" && "$current_sink_id" != "$target_id" ]]; then
			pactl move-sink-input "$input_id" "$target_sink" 2>/dev/null || true
		fi
	done < <(pactl list short sink-inputs 2>/dev/null)
}

sink_description() {
	local target_sink=$1
	LC_ALL=C pactl list sinks 2>/dev/null | awk -v sink="$target_sink" '
		$1 == "Name:" { current = $2; next }
		current == sink && $1 == "Description:" {
			sub(/^[[:space:]]*Description:[[:space:]]*/, "")
			print
			exit
		}
	'
}

select_sink() {
	local target_sink=$1
	local target_label=$2

	if ! pactl set-default-sink "$target_sink" 2>/dev/null; then
		notify 'No se pudo cambiar la salida'
		return 1
	fi
	move_streams "$target_sink"
	notify "$target_label"
}

current_sink=$(pactl get-default-sink 2>/dev/null || true)

# Los perfiles HDMI son mutuamente exclusivos. Se añaden como destinos lógicos;
# el resto de las salidas conectadas se obtiene de PipeWire en cada ejecución.
while read -r sink; do
	[[ -n "$sink" ]] || continue
	[[ -z "$sink_prefix" || "$sink" != "${sink_prefix}"hdmi-* ]] || continue
	description=$(sink_description "$sink")
	sinks+=("$sink")
	profiles+=('')
	labels+=("${description:-Salida de audio}")
done < <(pactl list short sinks 2>/dev/null | awk '{ print $2 }')

current_index=-1
for index in "${!sinks[@]}"; do
	if [[ "${sinks[index]}" == "$current_sink" ]]; then
		current_index=$index
		break
	fi
done

for ((offset = 1; offset <= ${#sinks[@]}; offset++)); do
	target_index=$(((current_index + offset) % ${#sinks[@]}))
	target_sink=${sinks[target_index]}
	target_profile=${profiles[target_index]}

	if [[ -n "$target_profile" ]] &&
		! pactl set-card-profile "$card" "$target_profile" 2>/dev/null; then
		continue
	fi

	# Un nodo HDMI tarda un instante en aparecer al cambiar el perfil de la tarjeta.
	for _ in {1..20}; do
		if pactl list short sinks 2>/dev/null | cut -f2 | grep -Fxq "$target_sink"; then
			if select_sink "$target_sink" \
				"${labels[target_index]} · $((target_index + 1))/${#sinks[@]}"; then
				exit 0
			fi
			break
		fi
		sleep 0.1
	done
done

notify 'No hay otra salida disponible'
exit 1
