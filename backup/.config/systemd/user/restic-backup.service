[Unit]
Description=Backup cifrado opcional con Ludusavi y Restic
Documentation=file:%h/.config/restic/dotfiles.paths
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
LoadCredentialEncrypted=restic-password:%h/.local/share/systemd/credentials/restic-password.cred
Environment=DOTFILES_RESTIC_ENV=1
Environment=RESTIC_PASSWORD_FILE=%d/restic-password
ExecStart=%h/.local/bin/dotfiles-backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUSchedulingPolicy=batch
TimeoutStartSec=6h
