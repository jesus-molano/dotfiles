#!/usr/bin/env bash
# shellcheck source-path=SCRIPTDIR
set -Eeuo pipefail

notify() {
	"$HOME/.local/bin/desktop-notify" "Backup" "$1" || true
}
status=0
trap 'status=$?; notify "Falló el backup Restic (código $status)"; exit "$status"' ERR

if [[ ${DOTFILES_RESTIC_ENV:-0} != 1 ]]; then
	exec "$HOME/.local/bin/with-secrets" env DOTFILES_RESTIC_ENV=1 "$0" "$@"
fi

# shellcheck source=../lib/dotfiles/restic-env.sh
source "$HOME/.local/lib/dotfiles/restic-env.sh"
load_dotfiles_restic_repository || true

command -v restic >/dev/null 2>&1 || {
	printf '%s\n' 'restic no está instalado.' >&2
	exit 127
}
[[ -n ${RESTIC_REPOSITORY:-} ]] || {
	printf '%s\n' 'Falta el repositorio Restic local o RESTIC_REPOSITORY.' >&2
	exit 2
}
[[ -n ${RESTIC_PASSWORD:-}${RESTIC_PASSWORD_FILE:-}${RESTIC_PASSWORD_COMMAND:-} ]] || {
	printf '%s\n' 'Falta un método de contraseña Restic en with-secrets.' >&2
	exit 2
}
export RESTIC_HOST="${RESTIC_HOST:-$(hostname)}"

config_root="${XDG_CONFIG_HOME:-$HOME/.config}/restic"
paths_config="$config_root/dotfiles.paths"
exclude_config="$config_root/dotfiles.excludes"
[[ -r "$paths_config" && -r "$exclude_config" ]] || {
	printf 'Falta configuración Restic bajo %s.\n' "$config_root" >&2
	exit 2
}

staging_root="${XDG_STATE_HOME:-$HOME/.local/state}/gaming/ludusavi"
mkdir -p -- "$staging_root"
if command -v ludusavi >/dev/null 2>&1; then
	ludusavi backup --force --no-cloud-sync --path "$staging_root"
else
	printf '%s\n' 'Aviso: Ludusavi no está instalado; se omite el staging de partidas.' >&2
fi

canary="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles-backup/canary.txt"
canary_dir=$(dirname -- "$canary")
install -d -m 700 -- "$canary_dir"
canary_token="$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')"
[[ "$canary_token" =~ ^[0-9a-f]{64}$ ]] || {
	printf '%s\n' 'No se pudo generar el token privado del canario Restic.' >&2
	exit 1
}
canary_temporary=$(mktemp "$canary_dir/.canary.XXXXXX")
chmod 600 "$canary_temporary"
printf '%s\n' \
	'dotfiles-restic-canary-v2' \
	"token=$canary_token" \
	"created_at=$(date +%s)" >"$canary_temporary"
mv -fT -- "$canary_temporary" "$canary"

runtime_root=${XDG_RUNTIME_DIR:-/tmp}
paths_file="$(mktemp --tmpdir="$runtime_root" desktop-restic-paths.XXXXXX)"
cleanup() {
	rm -f -- "${paths_file:-}" "${canary_temporary:-}"
}
trap cleanup EXIT

while IFS= read -r configured || [[ -n "$configured" ]]; do
	[[ -n "$configured" && "$configured" != \#* ]] || continue
	case "$configured" in
	[~]/*) path="$HOME/${configured:2}" ;;
	/*) path=$configured ;;
	*) path="$HOME/$configured" ;;
	esac
	if [[ -e "$path" || -L "$path" ]]; then
		printf '%s\n' "$path" >>"$paths_file"
	else
		printf 'Ruta ausente, omitida: %s\n' "$path" >&2
	fi
done <"$paths_config"

# El checkout es una propiedad local registrada por el resolvedor, no una ruta
# versionada. Solo se acepta un directorio absoluto para no respaldar rutas
# ambiguas ni contenido inyectado en la configuración.
repo_registry="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/repo"
if [[ -r "$repo_registry" ]]; then
	IFS= read -r registered_repo <"$repo_registry" || true
	if [[ "$registered_repo" == /* && -d "$registered_repo" ]] &&
		! grep -Fxq -- "$registered_repo" "$paths_file"; then
		printf '%s\n' "$registered_repo" >>"$paths_file"
	fi
fi

# La composición elegida y el registro del checkout también son estado de host.
# Se añaden como directorio XDG para que host.toml y repo se recuperen juntos,
# sin leerlos ni mostrarlos en la salida del backup.
dotfiles_config_root="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles"
if [[ -d "$dotfiles_config_root" ]] && ! grep -Fxq -- "$dotfiles_config_root" "$paths_file"; then
	printf '%s\n' "$dotfiles_config_root" >>"$paths_file"
fi

# Ludusavi respeta XDG_STATE_HOME, que no tiene por qué estar bajo ~/.local/state.
if [[ -e "$staging_root" ]] && ! grep -Fxq -- "$staging_root" "$paths_file"; then
	printf '%s\n' "$staging_root" >>"$paths_file"
fi
if ! grep -Fxq -- "$canary" "$paths_file"; then
	printf '%s\n' "$canary" >>"$paths_file"
fi

[[ -s "$paths_file" ]] || {
	printf '%s\n' 'No hay ninguna ruta existente que respaldar.' >&2
	exit 2
}

restic backup \
	--tag desktop \
	--files-from "$paths_file" \
	--exclude-file "$exclude_config"
restic forget \
	--tag desktop \
	--keep-daily 7 \
	--keep-weekly 5 \
	--keep-monthly 12

trap - ERR
notify 'Backup Restic completado'
