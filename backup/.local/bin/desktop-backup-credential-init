#!/usr/bin/env bash
set -Eeuo pipefail

if [[ ${DOTFILES_RESTIC_ENV:-0} != 1 ]]; then
	exec "$HOME/.local/bin/with-secrets" env DOTFILES_RESTIC_ENV=1 "$0" "$@"
fi

command -v systemd-creds >/dev/null 2>&1 || {
	printf '%s\n' 'systemd-creds no está disponible.' >&2
	exit 127
}
[[ -n ${RESTIC_PASSWORD:-} ]] || {
	printf '%s\n' 'RESTIC_PASSWORD no está definido mediante with-secrets.' >&2
	exit 2
}

credential_dir="${XDG_DATA_HOME:-$HOME/.local/share}/systemd/credentials"
credential_file="$credential_dir/restic-password.cred"
mkdir -p -- "$credential_dir"
chmod 700 -- "$credential_dir"

umask 077
temporary="$(mktemp --tmpdir="$credential_dir" .restic-password.XXXXXX)"
cleanup() {
	rm -f -- "$temporary"
}
trap cleanup EXIT

printf '%s' "$RESTIC_PASSWORD" | systemd-creds encrypt \
	--user \
	--with-key=host+tpm2 \
	--name=restic-password \
	- "$temporary"
unset RESTIC_PASSWORD
chmod 600 -- "$temporary"
mv -f -- "$temporary" "$credential_file"
trap - EXIT

printf '%s\n' 'Credencial Restic cifrada para los timers de usuario.'
