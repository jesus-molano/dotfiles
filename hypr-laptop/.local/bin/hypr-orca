#!/usr/bin/env bash
set -euo pipefail

# Focus the existing Orca window; start the app through UWSM only when needed.
if hyprctl clients -j | jq -e '.[] | select((.class // "" | ascii_downcase) == "orca")' >/dev/null; then
    exec hyprctl dispatch focuswindow 'class:^(orca)$'
fi

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
"$script_dir/orca-safe-settings"
exec uwsm app -- orca-ide open
