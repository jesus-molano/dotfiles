#!/usr/bin/env bash
set -euo pipefail

readonly watcher='org.kde.StatusNotifierWatcher'
readonly autostart_unit='app-1password@autostart.service'

command -v 1password >/dev/null 2>&1 || exit 0

for ((attempt = 0; attempt < 40; attempt++)); do
	busctl --user --quiet status "$watcher" >/dev/null 2>&1 && break
	sleep 0.25
done

# Without a watcher there is nowhere to expose the icon. Leave any XDG
# autostart instance untouched and try again at the next session start.
busctl --user --quiet status "$watcher" >/dev/null 2>&1 || exit 0

if systemctl --user cat "$autostart_unit" >/dev/null 2>&1; then
	systemctl --user daemon-reload
	systemctl --user restart "$autostart_unit"
else
	exec uwsm app -- 1password --silent
fi
