#!/usr/bin/env bash
set -euo pipefail

readonly watcher='org.kde.StatusNotifierWatcher'

command -v 1password >/dev/null 2>&1 || exit 0

watcher_ready=false
for ((attempt = 0; attempt < 40; attempt++)); do
	if busctl --user --quiet status "$watcher" >/dev/null 2>&1; then
		watcher_ready=true
		break
	fi
	sleep 0.25
done

# Without a watcher there is nowhere to expose the icon. Try again at the next
# session start instead of launching an instance that cannot register its tray.
[[ $watcher_ready == true ]] || exit 0

# This helper replaces ExecStart in the generated XDG autostart unit. Starting
# the application here avoids the former second launch and forced restart.
# This Electron build enables a Vulkan GPU process that is incompatible with
# native Wayland. 1Password does not need GPU acceleration in the tray.
exec 1password --silent --disable-gpu
