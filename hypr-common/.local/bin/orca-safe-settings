#!/usr/bin/env bash
set -euo pipefail

readonly profile="${ORCA_PROFILE:-local-default}"
readonly config_root="${XDG_CONFIG_HOME:-$HOME/.config}"
readonly settings="$config_root/orca/profiles/$profile/orca-data.json"
readonly active_palette="$config_root/noctalia/generated/active-palette.json"
readonly fallback_palette="$config_root/noctalia/palettes/ProjectAtlas.json"

[[ -f "$settings" ]] || exit 0
command -v jq >/dev/null || {
	printf 'orca-safe-settings: jq is required; settings left untouched.\n' >&2
	exit 0
}

# La paleta generada se puede leer mientras Noctalia la está sustituyendo. No
# basta con que exista: todos los valores que se escriben en Orca deben estar.
valid_palette() {
	jq -e '
    def hex: type == "string" and test("^#[0-9A-Fa-f]{6}$");
    .dark as $dark
    | [
        $dark.mSurface,
        $dark.mOutline,
        $dark.terminal.foreground,
        $dark.terminal.background,
        $dark.terminal.cursor,
        $dark.terminal.cursorText,
        $dark.terminal.selectionBg,
        $dark.terminal.selectionFg,
        $dark.terminal.normal.black,
        $dark.terminal.normal.red,
        $dark.terminal.normal.green,
        $dark.terminal.normal.yellow,
        $dark.terminal.normal.blue,
        $dark.terminal.normal.magenta,
        $dark.terminal.normal.cyan,
        $dark.terminal.normal.white,
        $dark.terminal.bright.black,
        $dark.terminal.bright.red,
        $dark.terminal.bright.green,
        $dark.terminal.bright.yellow,
        $dark.terminal.bright.blue,
        $dark.terminal.bright.magenta,
        $dark.terminal.bright.cyan,
        $dark.terminal.bright.white
      ]
    | all(hex)
  ' "$1" >/dev/null 2>&1
}

if valid_palette "$active_palette"; then
	readonly palette="$active_palette"
elif valid_palette "$fallback_palette"; then
	readonly palette="$fallback_palette"
else
	printf 'orca-safe-settings: no hay una paleta activa o fallback valida; ajustes sin cambios.\n' >&2
	exit 0
fi

# orca-ide remains as a background daemon after the UI closes. Only a visible
# Orca window can still hold in-memory settings that would overwrite this file.
readonly hyprctl_bin="${HYPRCTL_BIN:-hyprctl}"
orca_window_state() {
	local clients_json
	clients_json=$("$hyprctl_bin" clients -j 2>/dev/null) || return 2
	jq -r '
  if type != "array" then
    error("hyprctl clients no devolvio una lista")
  elif any(
    .[]?;
    [(.class // ""), (.initialClass // "")]
    | any(.[]; tostring | ascii_downcase | test("(^|[._-])orca([._-]ide)?($|[._-])"))
  ) then
    "visible"
  else
    "none"
  end
' <<<"$clients_json"
}

state_root="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/orca"
mkdir -p "$state_root"
chmod 700 "$state_root"
exec 9>"$state_root/settings.lock"
flock -w 2 9 || exit 0

if ! window_state=$(orca_window_state); then
	printf 'orca-safe-settings: no se pudieron validar las ventanas de Hyprland; ajustes sin cambios.\n' >&2
	exit 0
fi
if [[ "$window_state" == "visible" ]]; then
	exit 0
fi

tmp="$(mktemp "$state_root/orca-data.XXXXXX")"
trap 'rm -f "$tmp"' EXIT

jq --slurpfile palette "$palette" '
  ($palette[0].dark) as $theme
  | ($theme.terminal) as $terminal
  | .settings.telemetry.optedIn = false
  | .settings.terminalLineHeight = 1.15
  | .settings.terminalScrollbackRows = 20000
  | .settings.theme = "dark"
  | .settings.leftSidebarAppearanceMode = "match-terminal"
  | .settings.leftSidebarTintColor = $theme.mSurface
  | .settings.leftSidebarTintOpacity = 0.12
  | .settings.terminalThemeDark = "custom:manual:noctalia-active"
  | .settings.terminalUseSeparateLightTheme = false
  | .settings.terminalDividerColorDark = $theme.mOutline
  | .settings.terminalCustomThemes = (
      ((.settings.terminalCustomThemes // [])
        | map(select(.id != "manual:project-atlas" and .id != "manual:noctalia-active")))
      + [{
          id: "manual:noctalia-active",
          name: "Noctalia Active",
          source: "manual",
          sourceLabel: "Noctalia active palette",
          mode: "dark",
          importedAt: "1970-01-01T00:00:00.000Z",
          terminal: {
            foreground: $terminal.foreground,
            background: $terminal.background,
            cursor: $terminal.cursor,
            cursorAccent: $terminal.cursorText,
            selectionBackground: $terminal.selectionBg,
            selectionForeground: $terminal.selectionFg,
            black: $terminal.normal.black,
            red: $terminal.normal.red,
            green: $terminal.normal.green,
            yellow: $terminal.normal.yellow,
            blue: $terminal.normal.blue,
            magenta: $terminal.normal.magenta,
            cyan: $terminal.normal.cyan,
            white: $terminal.normal.white,
            brightBlack: $terminal.bright.black,
            brightRed: $terminal.bright.red,
            brightGreen: $terminal.bright.green,
            brightYellow: $terminal.bright.yellow,
            brightBlue: $terminal.bright.blue,
            brightMagenta: $terminal.bright.magenta,
            brightCyan: $terminal.bright.cyan,
            brightWhite: $terminal.bright.white,
            bold: $terminal.bright.white
          }
        }]
    )
' "$settings" >"$tmp"

if cmp -s "$settings" "$tmp"; then
	exit 0
fi

# Vuelve a consultar justo antes de escribir. Esto cierra la ventana de carrera
# normal entre preparar la paleta y que otra acción abra Orca.
if ! window_state=$(orca_window_state) || [[ "$window_state" == "visible" ]]; then
	exit 0
fi

backup="$state_root/orca-data.$(date +%Y%m%d-%H%M%S).json"
install -m 600 "$settings" "$backup"
install -m 600 "$tmp" "$settings"
printf 'Orca: ajustes seguros aplicados; backup en %s\n' "$backup"
