#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly hyprctl_bin="${HYPRCTL_BIN:-hyprctl}"
readonly safe_settings="${ORCA_SAFE_SETTINGS_BIN:-$script_dir/orca-safe-settings}"
readonly uwsm_bin="${UWSM_BIN:-uwsm}"
readonly orca_cli="${ORCA_CLI_BIN:-orca-ide}"

orca_workspace() {
	"$hyprctl_bin" clients -j | jq -r '
    [
      .[]
      | select(
          [(.class // ""), (.initialClass // "")]
          | any(.[]; ascii_downcase == "orca")
        )
    ][0].workspace.name // empty
  '
}

show_orca() {
	local workspace
	workspace=$(orca_workspace)
	case "$workspace" in
	special:orca)
		exec "$hyprctl_bin" eval 'hl.dispatch(hl.dsp.workspace.toggle_special("orca"))'
		;;
	"") return 1 ;;
	*) exec "$hyprctl_bin" eval 'hl.dispatch(hl.dsp.focus({ window = "class:^[Oo]rca$" }))' ;;
	esac
}

show_orca || true
"$safe_settings"
"$uwsm_bin" app -- "$orca_cli" open

# The window rule maps a new Orca window without focusing it. Reveal it only
# for an explicit Hyper+O launch, never during session autostart.
for _ in {1..50}; do
	show_orca || true
	sleep 0.1
done

printf '%s\n' 'hypr-orca: Orca runtime started but no window appeared' >&2
exit 1
