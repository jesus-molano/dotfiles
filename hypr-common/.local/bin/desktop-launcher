#!/usr/bin/env bash
set -euo pipefail

usage() {
	printf '%s\n' \
		'Uso: desktop-launcher {list|run} {projects|project-actions|ssh|media|typing|appearance|ports|crashes|commands} [selección]'
}

notify_error() {
	if command -v noctalia >/dev/null 2>&1; then
		noctalia msg notification-show 'Launcher' -- "$1" >/dev/null 2>&1 || true
	else
		notify-send 'Launcher' "$1" >/dev/null 2>&1 || true
	fi
}

project_roots() {
	printf '%s\0' \
		"$HOME/projects" \
		"$HOME/work" \
		"$HOME/.dotfiles" \
		"$HOME/orca/workspaces"
}

projects() {
	local root resolved git_marker project
	while IFS= read -r -d '' root; do
		[[ -e "$root" ]] || continue
		resolved="$(readlink -f -- "$root" 2>/dev/null || true)"
		[[ -d "$resolved" ]] || continue
		if [[ -e "$resolved/.git" ]]; then
			printf '%s\0' "$resolved"
		fi
		while IFS= read -r -d '' git_marker; do
			project=${git_marker%/.git}
			printf '%s\0' "$project"
		done < <(find -H "$resolved" -mindepth 2 -maxdepth 5 -name .git \
			\( -type d -o -type f \) -print0 2>/dev/null)
	done < <(project_roots) | sort -zu
}

project_token() {
	local action=$1 path=$2 slug digest
	slug="$(basename -- "$path" | LC_ALL=C tr -cs '[:alnum:]_-' '_' | cut -c1-28)"
	slug=${slug##_}
	slug=${slug%%_}
	[[ -n "$slug" ]] || slug=project
	digest="$(printf '%s' "$path" | sha256sum | cut -c1-12)"
	printf '%s_%s_%s' "$action" "$slug" "$digest"
}

safe_display() {
	local value=${1/#"$HOME"/\~}
	printf '%s' "$value" | LC_ALL=C tr -c '[:alnum:]_./~ -' '_'
}

list_projects() {
	local path display
	while IFS= read -r -d '' path; do
		display="$(safe_display "$path")"
		printf '%s\t%s — %s\n' "$(project_token session "$path")" "$(basename -- "$path")" "$display"
	done < <(projects)
}

list_project_actions() {
	local path display script_dir
	script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
	while IFS= read -r -d '' path; do
		display="$(safe_display "$path")"
		printf '%s\tSesión Orca + terminal - %s\n' "$(project_token session "$path")" "$display"
		printf '%s\tOrca - %s\n' "$(project_token orca "$path")" "$display"
		printf '%s\tGhostty - %s\n' "$(project_token term "$path")" "$display"
		printf '%s\tNvim - %s\n' "$(project_token nvim "$path")" "$display"
		if "$script_dir/project-session" has-tasks "$path" >/dev/null 2>&1; then
			printf '%s\tTareas - %s\n' "$(project_token tasks "$path")" "$display"
		fi
		if "$script_dir/project-session" has-preview "$path" >/dev/null 2>&1; then
			printf '%s\tPreview - %s\n' "$(project_token preview "$path")" "$display"
		fi
	done < <(projects)
}

find_project() {
	local selection=$1 action path
	action=${selection%%_*}
	case "$action" in
	session | orca | term | nvim | tasks | preview) ;;
	*) return 1 ;;
	esac
	while IFS= read -r -d '' path; do
		[[ "$(project_token "$action" "$path")" == "$selection" ]] || continue
		printf '%s' "$path"
		return 0
	done < <(projects)
	return 1
}

ssh_hosts() {
	local -a files=()
	local file host
	[[ -f "$HOME/.ssh/config" ]] && files+=("$HOME/.ssh/config")
	if [[ -d "$HOME/.ssh/config.d" ]]; then
		while IFS= read -r -d '' file; do files+=("$file"); done < <(
			find "$HOME/.ssh/config.d" -maxdepth 1 -type f -print0 2>/dev/null | sort -z
		)
	fi
	((${#files[@]})) || return 0
	awk 'tolower($1) == "host" {
		for (field = 2; field <= NF; field++)
			if ($field ~ /^[A-Za-z0-9._-]+$/) print $field
	}' "${files[@]}" | sort -u
}

list_ssh() {
	local host
	while IFS= read -r host; do
		[[ -n "$host" ]] && printf '%s\tSSH - %s\n' "$host" "$host"
	done < <(ssh_hosts)
}

list_media() {
	printf '%s\n' \
		$'stremio\tStremio' \
		$'youtube\tYouTube' \
		$'youtube_subscriptions\tYouTube - suscripciones' \
		$'spotify\tSpotify'
}

list_typing() {
	if command -v "${DESKTOP_LAUNCHER_TTYPER:-ttyper}" >/dev/null 2>&1; then
		printf '%s\n' \
			$'english_quick\tTtyper — inglés — 50 palabras' \
			$'english_long\tTtyper — inglés — 100 palabras' \
			$'python\tTtyper — Python' \
			$'javascript\tTtyper — JavaScript' \
			$'rust\tTtyper — Rust'
	fi
	printf '%s\n' $'keybr\tKeybr — entrenamiento adaptativo'
}

list_appearance() {
	local id label detail
	while IFS=$'\t' read -r id label detail; do
		[[ -n "$id" && -n "$label" ]] || continue
		printf '%s\t%s — %s\n' "$id" "$label" "$detail"
	done < <(appearance-switch list)
}

list_ports() {
	dev-ports list
}

list_crashes() {
	local token pid signal executable timestamp
	while IFS=$'\t' read -r token pid signal executable timestamp; do
		[[ -n "$token" ]] || continue
		printf '%s\tCrash %s — %s — %s — %s\n' "$token" "${pid#pid=}" \
			"${signal#signal=}" "$(basename -- "${executable#exe=}")" "${timestamp#time=}"
	done < <(crash-context list)
}

list_commands() {
	printf '%s\n' \
		$'doctor_host\tAuditar el host actual' \
		$'system_monitor\tbtop en Ghostty' \
		$'noctalia_settings\tAbrir ajustes de Noctalia' \
		$'capture_context\tCapturar, anotar y preparar contexto para Orca' \
		$'capture_qr\tLeer un código QR de la pantalla' \
		$'bug_capsule\tCrear cápsula local con captura, OCR y replay' \
		$'media_convert\tConvertir una imagen o un vídeo' \
		$'demo_studio\tIniciar o detener Demo Studio' \
		$'window_width_save\tGuardar el ancho de la ventana activa' \
		$'window_width_restore\tRestaurar el ancho guardado' \
		$'focus_toggle\tAlternar modo foco' \
		$'demo_mode\tPreparar una demo o grabación' \
		$'power_balanced\tPerfil energetico balanced' \
		$'power_performance\tPerfil energetico performance'
	if command -v whisper-cli >/dev/null 2>&1 && command -v wtype >/dev/null 2>&1; then
		printf '%s\n' $'dictation_toggle\tIniciar o terminar dictado local'
	fi
	if command -v game-run >/dev/null 2>&1; then
		printf '%s\n' $'direct_scanout_toggle\tAlternar direct scanout auto (experimental)'
	fi
}

run_project() {
	local selection=$1 category=$2 action path script_dir session_action
	path="$(find_project "$selection")" || {
		notify_error 'El proyecto seleccionado ya no está disponible.'
		return 1
	}
	action=${selection%%_*}
	[[ "$category" != projects || "$action" == session ]] || return 2
	case "$action" in
	session) session_action=resume ;;
	term) session_action=terminal ;;
	*) session_action=$action ;;
	esac
	script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
	[[ -x "$script_dir/project-session" ]] || {
		notify_error 'project-session no está disponible.'
		return 127
	}
	if [[ "${PROJECT_SESSION_DRY_RUN:-0}" == 1 ]]; then
		exec "$script_dir/project-session" --dry-run "$session_action" "$path"
	fi
	exec "$script_dir/project-session" "$session_action" "$path"
}

run_ssh() {
	local selection=$1 host
	host=${selection%%[[:space:]]*}
	[[ "$host" =~ ^[A-Za-z0-9._-]+$ ]] || return 2
	ssh_hosts | grep -Fxq -- "$host" || {
		notify_error 'El alias SSH seleccionado ya no existe.'
		return 1
	}
	exec uwsm app -- ghostty -e ssh "$host"
}

run_media() {
	case "$1" in
	stremio) exec hypr-stremio ;;
	youtube) exec uwsm app -- qutebrowser 'https://www.youtube.com/' ;;
	youtube_subscriptions) exec uwsm app -- qutebrowser 'https://www.youtube.com/feed/subscriptions' ;;
	spotify) exec hypr-spotify ;;
	*) return 2 ;;
	esac
}

run_typing() {
	local ttyper_bin=${DESKTOP_LAUNCHER_TTYPER:-ttyper}
	case "$1" in
	english_quick | english_long | python | javascript | rust)
		command -v "$ttyper_bin" >/dev/null 2>&1 || {
			notify_error 'Ttyper no está instalado en este perfil.'
			return 127
		}
		case "$1" in
		english_quick) exec uwsm app -- ghostty -e "$ttyper_bin" -l english1000 -w 50 ;;
		english_long) exec uwsm app -- ghostty -e "$ttyper_bin" -l english1000 -w 100 ;;
		python) exec uwsm app -- ghostty -e "$ttyper_bin" -l python -w 30 ;;
		javascript) exec uwsm app -- ghostty -e "$ttyper_bin" -l javascript -w 30 ;;
		rust) exec uwsm app -- ghostty -e "$ttyper_bin" -l rust -w 30 ;;
		esac
		;;
	keybr) exec uwsm app -- /usr/bin/brave --app='https://www.keybr.com/' ;;
	*) return 2 ;;
	esac
}

run_appearance() {
	[[ "$1" =~ ^[a-z0-9][a-z0-9-]*$ ]] || return 2
	exec appearance-switch apply "$1"
}

run_port() {
	[[ "$1" =~ ^port_[0-9]+_pid_[0-9]+_addr_([0-9A-Fa-f:.]+|\*)$ ]] || return 2
	exec dev-ports open "$1"
}

run_crash() {
	[[ "$1" =~ ^[0-9]+-[0-9]+-[0-9]+$ ]] || return 2
	exec crash-context select "$1"
}

run_command() {
	local dotfiles_root
	case "$1" in
	doctor_host)
		dotfiles_root="$(readlink -f -- "$HOME/.dotfiles" 2>/dev/null || true)"
		[[ -d "$dotfiles_root" ]] || return 1
		# $1 debe expandirse dentro del Bash hijo, no en este proceso.
		# shellcheck disable=SC2016
		exec uwsm app -- ghostty -e bash -lc \
			'cd -- "$1"; just doctor-live; printf "\nPulsa Enter para cerrar... "; read -r _' \
			bash "$dotfiles_root"
		;;
	system_monitor) exec uwsm app -- ghostty -e btop ;;
	noctalia_settings) exec noctalia msg settings-open ;;
	capture_context) exec capture-context --focus orca ;;
	capture_qr) exec capture-qr ;;
	bug_capsule) exec bug-capsule ;;
	media_convert) exec media-convert ;;
	demo_studio)
		if [[ $(demo-studio status) == recording ]]; then
			exec demo-studio stop
		fi
		exec demo-studio show
		;;
	window_width_save) exec hypr-window-width save ;;
	window_width_restore) exec hypr-window-width restore ;;
	dictation_toggle)
		command -v whisper-cli >/dev/null 2>&1 && command -v wtype >/dev/null 2>&1 || return 127
		exec local-dictation toggle --paste
		;;
	focus_toggle) exec desktop-focus-mode toggle ;;
	demo_mode) exec desktop-focus-mode demo-toggle ;;
	direct_scanout_toggle)
		command -v game-run >/dev/null 2>&1 || return 127
		exec direct-scanout-toggle toggle
		;;
	power_balanced) exec powerprofilesctl set balanced ;;
	power_performance) exec powerprofilesctl set performance ;;
	*) return 2 ;;
	esac
}

(($# >= 2)) || {
	usage >&2
	exit 2
}
mode=$1
category=$2
selection=${3:-}

case "$mode:$category" in
list:projects) list_projects ;;
list:project-actions) list_project_actions ;;
list:ssh) list_ssh ;;
list:media) list_media ;;
list:typing) list_typing ;;
list:appearance) list_appearance ;;
list:ports) list_ports ;;
list:crashes) list_crashes ;;
list:commands) list_commands ;;
run:projects | run:project-actions) [[ -n "$selection" ]] && run_project "$selection" "$category" ;;
run:ssh) [[ -n "$selection" ]] && run_ssh "$selection" ;;
run:media) [[ -n "$selection" ]] && run_media "$selection" ;;
run:typing) [[ -n "$selection" ]] && run_typing "$selection" ;;
run:appearance) [[ -n "$selection" ]] && run_appearance "$selection" ;;
run:ports) [[ -n "$selection" ]] && run_port "$selection" ;;
run:crashes) [[ -n "$selection" ]] && run_crash "$selection" ;;
run:commands) [[ -n "$selection" ]] && run_command "$selection" ;;
*)
	usage >&2
	exit 2
	;;
esac
