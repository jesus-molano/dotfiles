#!/usr/bin/env bash
set -euo pipefail

usage() {
	printf '%s\n' \
		'Usage: desktop-launcher {list|run|open} CATEGORY [SELECTION]'
}

notify_error() {
	if command -v noctalia >/dev/null 2>&1; then
		noctalia msg notification-show 'Launcher' -- "$1" >/dev/null 2>&1 || true
	else
		notify-send 'Launcher' "$1" >/dev/null 2>&1 || true
	fi
}

project_roots() {
	printf '%s\0' \
		"$HOME/projects" \
		"$HOME/work" \
		"$HOME/.dotfiles" \
		"$HOME/orca/workspaces"
}

projects() {
	local root resolved git_marker project
	while IFS= read -r -d '' root; do
		[[ -e "$root" ]] || continue
		resolved="$(readlink -f -- "$root" 2>/dev/null || true)"
		[[ -d "$resolved" ]] || continue
		if [[ -e "$resolved/.git" ]]; then
			printf '%s\0' "$resolved"
		fi
		while IFS= read -r -d '' git_marker; do
			project=${git_marker%/.git}
			printf '%s\0' "$project"
		done < <(find -H "$resolved" -mindepth 2 -maxdepth 5 -name .git \
			\( -type d -o -type f \) -print0 2>/dev/null)
	done < <(project_roots) | sort -zu
}

project_token() {
	local action=$1 path=$2 slug digest
	slug="$(basename -- "$path" | LC_ALL=C tr -cs '[:alnum:]_-' '_' | cut -c1-28)"
	slug=${slug##_}
	slug=${slug%%_}
	[[ -n "$slug" ]] || slug=project
	digest="$(printf '%s' "$path" | sha256sum | cut -c1-12)"
	printf '%s_%s_%s' "$action" "$slug" "$digest"
}

project_title() {
	local path=$1 title
	title=$(basename -- "$path")
	if [[ "$path" == "$HOME/orca/workspaces/"*/* ]]; then
		title=${title#auto-}
		title=$(printf '%s' "$title" | sed -E \
			's/-run-[0-9]+-[0-9]{8}T[0-9]{4,6}$//; s/[-_]+/ /g; s/[[:space:]]+/ /g')
		title=${title^}
	fi
	printf '%s' "$title"
}

project_context() {
	local path=$1 repository
	if [[ "$path" == "$HOME/orca/workspaces/"*/* ]]; then
		repository=$(basename -- "$(dirname -- "$path")")
		printf 'Orca workspace for %s' "$repository"
		return
	fi
	safe_display "$path"
}

safe_display() {
	local value=${1/#"$HOME"/\~}
	printf '%s' "$value" | tr '\t\r\n' '   ' | tr -d '\\"$`'
}

emit_record() {
	local id=$1 title description
	title=$(safe_display "$2")
	description=$(safe_display "$3")
	printf '%s\t%s\t%s\n' "$id" "$title" "$description"
}

render_records() {
	local id title description
	while IFS=$'\t' read -r id title description; do
		[[ -n "$id" && -n "$title" ]] || continue
		printf '%s\t%s\n' "$title" "$description"
	done
}

record_id_for_selection() {
	local selection=$1 generator=$2 id title description
	while IFS=$'\t' read -r id title description; do
		[[ "$title"$'\t'"$description" == "$selection" ]] || continue
		printf '%s' "$id"
		return 0
	done < <("$generator")
	return 1
}

legacy_project_token_for_selection() {
	local selection=$1 token
	[[ "$selection" == *$'\t'* ]] || return 1
	token=${selection%%$'\t'*}
	[[ "$token" =~ ^(session|chatgpt|orca|term|nvim|tasks|preview)_[[:alnum:]_-]+_[0-9a-f]{12}$ ]] || return 1
	printf '%s' "$token"
}

project_records() {
	local category=$1 path title context action_context
	while IFS= read -r -d '' path; do
		title=$(project_title "$path")
		context=$(project_context "$path")
		if [[ "$category" == projects ]]; then
			emit_record "$(project_token session "$path")" "$title" \
				"Open ChatGPT with terminal — $context"
			continue
		fi
		action_context=$context
		if [[ "$path" == "$HOME/orca/workspaces/"*/* ]]; then
			action_context="$title — $context"
		fi
		emit_record "$(project_token session "$path")" 'ChatGPT session and terminal' "$action_context"
		emit_record "$(project_token chatgpt "$path")" 'Open ChatGPT' "$action_context"
		emit_record "$(project_token term "$path")" 'Open terminal' "$action_context"
		emit_record "$(project_token nvim "$path")" 'Open in Nvim' "$action_context"
		local script_dir
		script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
		if "$script_dir/project-session" has-tasks "$path" >/dev/null 2>&1; then
			emit_record "$(project_token tasks "$path")" 'Open tasks' "$action_context"
		fi
		if "$script_dir/project-session" has-preview "$path" >/dev/null 2>&1; then
			emit_record "$(project_token preview "$path")" 'Open preview' "$action_context"
		fi
	done < <(projects)
}

project_records_projects() { project_records projects; }
project_records_project_actions() { project_records project-actions; }
list_projects() { project_records_projects | render_records; }
list_project_actions() { project_records_project_actions | render_records; }

find_project() {
	local selection=$1 action path
	action=${selection%%_*}
	case "$action" in
	session | chatgpt | orca | term | nvim | tasks | preview) ;;
	*) return 1 ;;
	esac
	while IFS= read -r -d '' path; do
		[[ "$(project_token "$action" "$path")" == "$selection" ]] || continue
		printf '%s' "$path"
		return 0
	done < <(projects)
	return 1
}

ssh_hosts() {
	local -a files=()
	local file host
	[[ -f "$HOME/.ssh/config" ]] && files+=("$HOME/.ssh/config")
	if [[ -d "$HOME/.ssh/config.d" ]]; then
		while IFS= read -r -d '' file; do files+=("$file"); done < <(
			find "$HOME/.ssh/config.d" -maxdepth 1 -type f -print0 2>/dev/null | sort -z
		)
	fi
	((${#files[@]})) || return 0
	awk 'tolower($1) == "host" {
		for (field = 2; field <= NF; field++)
			if ($field ~ /^[A-Za-z0-9._-]+$/) print $field
	}' "${files[@]}" | sort -u
}

ssh_records() {
	local host
	while IFS= read -r host; do
		[[ -n "$host" ]] && emit_record "$host" "$host" 'Open SSH session'
	done < <(ssh_hosts)
}
list_ssh() { ssh_records | render_records; }

media_records() {
	emit_record stremio 'Stremio' 'Movies and series'
	emit_record youtube 'YouTube' 'Videos'
	emit_record youtube_subscriptions 'YouTube subscriptions' 'Videos from followed channels'
	emit_record spotify 'Spotify' 'Music and podcasts'
}
list_media() { media_records | render_records; }

ttyper_records() {
	emit_record english_quick 'Ttyper — quick English' '50 words from english1000'
	emit_record english_long 'Ttyper — long English' '100 words from english1000'
	emit_record python 'Ttyper — Python' '30 code words'
	emit_record javascript 'Ttyper — JavaScript' '30 code words'
	emit_record rust 'Ttyper — Rust' '30 code words'
}

keybr_record() {
	emit_record keybr 'Keybr' 'Adaptive typing practice'
}

typing_records() {
	ttyper_records
	keybr_record
}

list_typing() {
	{
		if command -v "${DESKTOP_LAUNCHER_TTYPER:-ttyper}" >/dev/null 2>&1; then
			ttyper_records
		fi
		keybr_record
	} | render_records
}

appearance_records() {
	local id label _detail
	while IFS=$'\t' read -r id label _detail; do
		[[ -n "$id" && -n "$label" ]] || continue
		emit_record "$id" "$label" 'Apply coordinated palette and wallpapers'
	done < <(appearance-switch list)
}
list_appearance() { appearance_records | render_records; }

keybinding_records() {
	local hyprctl_bin=${DESKTOP_LAUNCHER_HYPRCTL:-hyprctl}
	command -v jq >/dev/null 2>&1 || return 127
	command -v "$hyprctl_bin" >/dev/null 2>&1 || return 127
	"$hyprctl_bin" binds -j | jq -er '
		if type != "array" then error("hyprctl binds did not return a list") else . end
		| .[]
		| select(
			.has_description == true
			and (.modmask | type == "number")
			and .modmask >= 0
			and .modmask <= 255
			and (.key | type == "string")
			and (.description | type == "string")
			and .key != ""
			and .description != ""
		)
		| [
			(.modmask | floor | tostring),
			(.key | gsub("[\\t\\r\\n]+"; " ")),
			(.description | gsub("[\\t\\r\\n]+"; " "))
		]
		| @tsv
	'
}

format_keybinding_key() {
	case "$1" in
	Return) printf '%s' 'Enter' ;;
	bracketleft) printf '%s' '[' ;;
	bracketright) printf '%s' ']' ;;
	comma) printf '%s' ',' ;;
	period) printf '%s' '.' ;;
	semicolon) printf '%s' ';' ;;
	'mouse:272') printf '%s' 'Mouse 1' ;;
	'mouse:273') printf '%s' 'Mouse 2' ;;
	*) printf '%s' "$1" ;;
	esac
}

format_keybinding() {
	local mask=$1 key=$2
	local -a parts=()
	local combo part
	if ((mask == 77)); then
		parts+=(Hyper)
	else
		((mask & 4)) && parts+=(Ctrl)
		((mask & 8)) && parts+=(Alt)
		((mask & 64)) && parts+=(Super)
		((mask & 1)) && parts+=(Shift)
		((mask & 2)) && parts+=(Caps)
		((mask & 16)) && parts+=(Mod2)
		((mask & 32)) && parts+=(Mod3)
		((mask & 128)) && parts+=(Mod5)
	fi
	parts+=("$(format_keybinding_key "$key")")
	combo=${parts[0]}
	for part in "${parts[@]:1}"; do
		combo+=" + $part"
	done
	printf '%s' "$combo"
}

keybinding_category() {
	case "$1" in
	*workspace* | *scratchpad*) printf '%s' workspaces ;;
	'Move focus '* | 'Move window '* | 'Resize window '* | 'Close active window' | \
		'Maximize active window' | 'Toggle floating window' | 'Toggle split direction' | \
		'Move one column '* | 'Toggle scrolling column width' | 'Toggle fullscreen' | \
		'Toggle window group' | 'Focus next window in group' | 'Focus previous window in group' | \
		'Open Noctalia window switcher' | 'Drag window' | 'Resize window') printf '%s' windows ;;
	'Open Ghostty' | 'Open Brave' | 'Open Dolphin' | 'Open Yazi in Ghostty' | \
		'Focus or open ChatGPT' | 'Focus or open Spotify' | 'Focus or open Stremio' | \
		'Focus or open Steam' | 'Open launcher' | 'Open launcher commands' | \
		'Open launcher projects' | 'Open launcher media' | 'Open 1Password') printf '%s' apps ;;
	*volume* | 'Mute audio' | 'Mute microphone' | 'Play or pause' | 'Next track' | \
		'Previous track' | 'Capture a region' | 'Capture a region and prepare context for ChatGPT' | \
		*zoom* | *wallpaper* | *appearance* | 'Pick and copy a color') printf '%s' media ;;
	*) printf '%s' system ;;
	esac
}

keybinding_category_records() {
	emit_record windows 'Windows and focus' 'Movement, size, and layout'
	emit_record workspaces 'Workspaces' 'Desktops and special workspaces'
	emit_record apps 'Applications' 'Programs and launchers'
	emit_record media 'Media and capture' 'Audio, playback, images, and appearance'
	emit_record system 'System and session' 'Input, session, and utilities'
	emit_record all 'All keybindings' 'Complete list for global search'
}

list_keybinding_categories() { keybinding_category_records | render_records; }

list_keybindings() {
	local wanted=${1:-all} mask key description combo category
	while IFS=$'\t' read -r mask key description; do
		[[ -n "$mask" && -n "$key" && -n "$description" ]] || continue
		category=$(keybinding_category "$description")
		[[ "$wanted" == all || "$category" == "$wanted" ]] || continue
		combo=$(format_keybinding "$mask" "$key")
		printf '%s\t%s\n' "$(safe_display "$combo")" "$(safe_display "$description")"
	done < <(keybinding_records)
}

port_records() {
	local token label
	while IFS=$'\t' read -r token label; do
		[[ -n "$token" && -n "$label" ]] || continue
		label=${label// - / — }
		emit_record "$token" "$label" 'Open local development server in the browser'
	done < <(dev-ports list)
}
list_ports() { port_records | render_records; }

crash_reason() {
	case "$1" in
	4 | SIGILL) printf '%s' 'Illegal instruction' ;;
	5 | SIGTRAP) printf '%s' 'Trace or breakpoint trap' ;;
	6 | SIGABRT) printf '%s' 'Aborted' ;;
	7 | SIGBUS) printf '%s' 'Bus error' ;;
	8 | SIGFPE) printf '%s' 'Arithmetic exception' ;;
	9 | SIGKILL) printf '%s' 'Killed' ;;
	11 | SIGSEGV) printf '%s' 'Segmentation fault' ;;
	13 | SIGPIPE) printf '%s' 'Broken pipe' ;;
	15 | SIGTERM) printf '%s' 'Terminated' ;;
	*) printf '%s' 'Unexpected process failure' ;;
	esac
}

crash_records() {
	local token _pid signal executable timestamp reason
	while IFS=$'\t' read -r token _pid signal executable timestamp; do
		[[ -n "$token" ]] || continue
		reason=$(crash_reason "${signal#signal=}")
		timestamp=${timestamp#time=}
		if [[ -n "$timestamp" ]]; then
			reason+=" — $timestamp"
		fi
		emit_record "$token" "Crash in $(basename -- "${executable#exe=}")" "$reason"
	done < <(crash-context list)
}
list_crashes() { crash_records | render_records; }

share_records() {
	emit_record clipboard 'Clipboard' 'Send copied text'
	emit_record file 'Files' 'Choose one or more files'
	emit_record folder 'Folder' 'Choose a folder'
}
list_share() { share_records | render_records; }

command_records() {
	emit_record doctor_host 'Audit this computer' 'Check configuration and current host state'
	emit_record system_monitor 'System monitor' 'Open btop in Ghostty'
	emit_record noctalia_settings 'Noctalia settings' 'Open shell configuration'
	emit_record capture_context 'Capture context' 'Capture, annotate, and prepare context for ChatGPT'
	emit_record capture_qr 'Read QR code' 'Scan a QR code from the screen'
	emit_record bug_capsule 'Create bug capsule' 'Collect a screenshot, OCR, and replay locally'
	emit_record media_convert 'Convert media' 'Convert an image or video'
	emit_record demo_studio 'Demo Studio' 'Start or stop a presentation recording'
	emit_record window_width_save 'Save window width' 'Remember the active window width'
	emit_record window_width_restore 'Restore window width' 'Restore the saved width'
	emit_record focus_toggle 'Toggle focus mode' 'Control distractions and performance'
	emit_record demo_mode 'Prepare demo mode' 'Set up the desktop for a demo or recording'
	emit_record timer 'Timer' 'Start or manage a countdown'
	emit_record appearance_next 'Next appearance' 'Cycle coordinated palette and wallpapers'
	emit_record power_balanced 'Use balanced power' 'Switch to the balanced power profile'
	emit_record power_performance 'Use performance power' 'Switch to the performance power profile'
	if command -v whisper-cli >/dev/null 2>&1 && command -v wtype >/dev/null 2>&1; then
		emit_record dictation_toggle 'Toggle local dictation' 'Start or stop speech-to-text input'
	fi
	if command -v game-run >/dev/null 2>&1; then
		emit_record direct_scanout_toggle 'Toggle direct scanout' 'Change the experimental automatic setting'
	fi
}
list_commands() { command_records | render_records; }

run_project() {
	local selection=$1 category=$2 token action path script_dir session_action generator
	case "$category" in
	projects) generator=project_records_projects ;;
	project-actions) generator=project_records_project_actions ;;
	*) return 2 ;;
	esac
	# Noctalia persists recent rows. Accept the former token-first format and
	# silently ignore entries whose project disappeared or whose format changed.
	if token=$(record_id_for_selection "$selection" "$generator"); then
		:
	elif [[ "$category" == projects ]] &&
		record_id_for_selection "$selection" project_records_project_actions >/dev/null; then
		return 2
	else
		token=$(legacy_project_token_for_selection "$selection") || return 0
	fi
	path="$(find_project "$token")" || return 0
	action=${token%%_*}
	[[ "$category" != projects || "$action" == session ]] || return 2
	case "$action" in
	session) session_action=resume ;;
	term) session_action=terminal ;;
	*) session_action=$action ;;
	esac
	script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
	[[ -x "$script_dir/project-session" ]] || {
		notify_error 'Project session support is unavailable.'
		return 127
	}
	if [[ "${PROJECT_SESSION_DRY_RUN:-0}" == 1 ]]; then
		exec "$script_dir/project-session" --dry-run "$session_action" "$path"
	fi
	exec "$script_dir/project-session" "$session_action" "$path"
}

run_ssh() {
	local selection=$1 host
	host=$(record_id_for_selection "$selection" ssh_records) || return 2
	[[ "$host" =~ ^[A-Za-z0-9._-]+$ ]] || return 2
	ssh_hosts | grep -Fxq -- "$host" || {
		notify_error 'The selected SSH alias no longer exists.'
		return 1
	}
	exec uwsm app -- ghostty -e ssh "$host"
}

run_media() {
	local id
	id=$(record_id_for_selection "$1" media_records) || return 2
	case "$id" in
	stremio) exec hypr-stremio ;;
	youtube) exec uwsm app -- brave 'https://www.youtube.com/' ;;
	youtube_subscriptions) exec uwsm app -- brave 'https://www.youtube.com/feed/subscriptions' ;;
	spotify) exec hypr-spotify ;;
	*) return 2 ;;
	esac
}

run_typing() {
	local ttyper_bin=${DESKTOP_LAUNCHER_TTYPER:-ttyper} id
	id=$(record_id_for_selection "$1" typing_records) || return 2
	case "$id" in
	english_quick | english_long | python | javascript | rust)
		command -v "$ttyper_bin" >/dev/null 2>&1 || {
			notify_error 'Ttyper is not installed in this profile.'
			return 127
		}
		case "$id" in
		english_quick) exec uwsm app -- ghostty -e "$ttyper_bin" -l english1000 -w 50 ;;
		english_long) exec uwsm app -- ghostty -e "$ttyper_bin" -l english1000 -w 100 ;;
		python) exec uwsm app -- ghostty -e "$ttyper_bin" -l python -w 30 ;;
		javascript) exec uwsm app -- ghostty -e "$ttyper_bin" -l javascript -w 30 ;;
		rust) exec uwsm app -- ghostty -e "$ttyper_bin" -l rust -w 30 ;;
		esac
		;;
	keybr) exec uwsm app -- /usr/bin/brave --app='https://www.keybr.com/' ;;
	*) return 2 ;;
	esac
}

run_appearance() {
	local id
	id=$(record_id_for_selection "$1" appearance_records) || return 2
	[[ "$id" =~ ^[a-z0-9][a-z0-9-]*$ ]] || return 2
	exec appearance-switch apply "$id"
}

run_port() {
	local token
	token=$(record_id_for_selection "$1" port_records) || return 2
	[[ "$token" =~ ^port_[0-9]+_pid_[0-9]+_addr_([0-9A-Fa-f:.]+|\*)$ ]] || return 2
	exec dev-ports open "$token"
}

run_crash() {
	local token
	token=$(record_id_for_selection "$1" crash_records) || return 2
	[[ "$token" =~ ^[0-9]+-[0-9]+-[0-9]+$ ]] || return 2
	exec crash-context select "$token"
}

run_share() {
	local id
	id=$(record_id_for_selection "$1" share_records) || return 2
	case "$id" in
	clipboard | file | folder) exec local-share "$id" ;;
	*) return 2 ;;
	esac
}

open_noctalia_timer() {
	local attempt local_manifest manifest output
	local_manifest="${XDG_DATA_HOME:-$HOME/.local/share}/noctalia/plugins/timer/plugin.toml"
	manifest="${XDG_STATE_HOME:-$HOME/.local/state}/noctalia/plugins/materialized/official/timer/plugin.toml"

	if output="$(noctalia msg panel-toggle noctalia/timer:panel 2>&1)"; then
		return 0
	fi
	[[ "$output" == *'unknown panel'* ]] || {
		notify_error 'Noctalia could not open Timer.'
		return 1
	}

	if [[ ! -f "$local_manifest" ]]; then
		noctalia msg plugins enable noctalia/timer >/dev/null 2>&1 || {
			notify_error 'Noctalia could not install Timer.'
			return 1
		}
		for ((attempt = 0; attempt < 60; attempt++)); do
			[[ -f "$manifest" ]] && break
			sleep 0.5
		done
		[[ -f "$manifest" ]] || {
			notify_error 'Timer installation did not finish.'
			return 1
		}
	fi

	noctalia msg config-reload >/dev/null 2>&1 || {
		notify_error 'Noctalia could not reload Timer.'
		return 1
	}
	for ((attempt = 0; attempt < 40; attempt++)); do
		if noctalia msg panel-open noctalia/timer:panel >/dev/null 2>&1; then
			return 0
		fi
		sleep 0.25
	done

	notify_error 'Timer is installed but its panel is not ready.'
	return 1
}

run_command() {
	local dotfiles_root id
	id=$(record_id_for_selection "$1" command_records) || return 2
	case "$id" in
	doctor_host)
		dotfiles_root="$(readlink -f -- "$HOME/.dotfiles" 2>/dev/null || true)"
		[[ -d "$dotfiles_root" ]] || return 1
		# Expand $1 inside the child shell, not in this process.
		# shellcheck disable=SC2016
		exec uwsm app -- ghostty -e bash -lc \
			'cd -- "$1"; just doctor-live; printf "\nPress Enter to close... "; read -r _' \
			bash "$dotfiles_root"
		;;
	system_monitor) exec uwsm app -- ghostty -e btop ;;
	noctalia_settings) exec noctalia msg settings-open ;;
	capture_context) exec capture-context --focus chatgpt ;;
	capture_qr) exec capture-qr ;;
	bug_capsule) exec bug-capsule ;;
	media_convert) exec media-convert ;;
	demo_studio)
		if [[ $(demo-studio status) == recording ]]; then
			exec demo-studio stop
		fi
		exec demo-studio show
		;;
	window_width_save) exec hypr-window-width save ;;
	window_width_restore) exec hypr-window-width restore ;;
	dictation_toggle)
		command -v whisper-cli >/dev/null 2>&1 && command -v wtype >/dev/null 2>&1 || return 127
		exec local-dictation toggle --paste
		;;
	focus_toggle) exec desktop-focus-mode toggle ;;
	demo_mode) exec desktop-focus-mode demo-toggle ;;
	timer) open_noctalia_timer ;;
	appearance_next) exec appearance-switch next ;;
	direct_scanout_toggle)
		command -v game-run >/dev/null 2>&1 || return 127
		exec direct-scanout-toggle toggle
		;;
	power_balanced) exec powerprofilesctl set balanced ;;
	power_performance) exec powerprofilesctl set performance ;;
	*) return 2 ;;
	esac
}

run_keybinding_category() {
	local id
	id=$(record_id_for_selection "$1" keybinding_category_records) || return 2
	case "$id" in
	windows | workspaces | apps | media | system | all) ;;
	*) return 2 ;;
	esac
	exec noctalia msg panel-open launcher "/keys-$id"
}

(($# >= 2)) || {
	usage >&2
	exit 2
}
mode=$1
category=$2
selection=${3:-}

case "$mode:$category" in
list:projects) list_projects ;;
list:project-actions) list_project_actions ;;
list:ssh) list_ssh ;;
list:media) list_media ;;
list:typing) list_typing ;;
list:appearance) list_appearance ;;
list:keybindings) list_keybinding_categories ;;
list:keybindings-windows) list_keybindings windows ;;
list:keybindings-workspaces) list_keybindings workspaces ;;
list:keybindings-apps) list_keybindings apps ;;
list:keybindings-media) list_keybindings media ;;
list:keybindings-system) list_keybindings system ;;
list:keybindings-all) list_keybindings all ;;
list:ports) list_ports ;;
list:crashes) list_crashes ;;
list:share) list_share ;;
list:commands) list_commands ;;
run:projects | run:project-actions) [[ -n "$selection" ]] && run_project "$selection" "$category" ;;
run:ssh) [[ -n "$selection" ]] && run_ssh "$selection" ;;
run:media) [[ -n "$selection" ]] && run_media "$selection" ;;
run:typing) [[ -n "$selection" ]] && run_typing "$selection" ;;
run:appearance) [[ -n "$selection" ]] && run_appearance "$selection" ;;
run:keybinding-categories) [[ -n "$selection" ]] && run_keybinding_category "$selection" ;;
run:ports) [[ -n "$selection" ]] && run_port "$selection" ;;
run:crashes) [[ -n "$selection" ]] && run_crash "$selection" ;;
run:share) [[ -n "$selection" ]] && run_share "$selection" ;;
run:commands) [[ -n "$selection" ]] && run_command "$selection" ;;
open:timer) open_noctalia_timer ;;
*)
	usage >&2
	exit 2
	;;
esac
