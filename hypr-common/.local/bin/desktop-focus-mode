#!/usr/bin/env bash
set -euo pipefail

usage() {
	printf '%s\n' 'Uso: desktop-focus-mode {status|on|demo|off|toggle|demo-toggle}'
}

readonly state_root="${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/desktop-focus-mode"
readonly state_file="$state_root/state"
readonly gaming_sessions="${XDG_RUNTIME_DIR:-/tmp}/dotfiles-gaming-sessions"

require_noctalia() {
	command -v noctalia >/dev/null 2>&1 || {
		printf '%s\n' 'desktop-focus-mode: Noctalia no está disponible.' >&2
		exit 127
	}
}

read_status() {
	noctalia msg status
}

read_bool() {
	local key=$1 value
	value="$(read_status | jq -r ".$key" 2>/dev/null)" || return 1
	case "$value" in
	true | false) printf '%s\n' "$value" ;;
	*) return 1 ;;
	esac
}

read_caffeine() {
	systemd-inhibit --list --json=short 2>/dev/null | jq -er '
		if any(.[];
			(.who // "" | ascii_downcase) == "noctalia" and
			(.why // "" | ascii_downcase) == "caffeine" and
			((.what // "" | split(":")) | index("idle")) != null
		) then "on" else "off" end'
}

read_power_profile() {
	local profile
	profile="$(powerprofilesctl get 2>/dev/null)" || return 1
	case "$profile" in
	performance | balanced | power-saver) printf '%s\n' "$profile" ;;
	*) return 1 ;;
	esac
}

process_starttime() {
	local pid=$1 stat_line remainder
	local -a fields
	[[ "$pid" =~ ^[0-9]+$ && -r "/proc/$pid/stat" ]] || return 1
	stat_line=$(<"/proc/$pid/stat")
	remainder=${stat_line##*) }
	read -r -a fields <<<"$remainder"
	((${#fields[@]} >= 20)) && [[ "${fields[19]}" =~ ^[0-9]+$ ]] || return 1
	printf '%s\n' "${fields[19]}"
}

gaming_active() {
	local marker pid expected extra current
	[[ -d "$gaming_sessions" ]] || return 1
	for marker in "$gaming_sessions"/*; do
		[[ -f "$marker" ]] || continue
		read -r pid expected extra <"$marker" || true
		current="$(process_starttime "${pid:-}" 2>/dev/null || true)"
		if [[ "$pid" =~ ^[0-9]+$ && "$expected" =~ ^[0-9]+$ && -z "${extra:-}" && "$current" == "$expected" ]]; then
			return 0
		fi
		rm -f -- "$marker"
	done
	return 1
}

recording_identity() {
	local pid starttime
	# Linux trunca comm a 15 caracteres. Buscar la línea de órdenes completa
	# evita que gpu-screen-recorder quede invisible para el modo demo.
	pid="$(pgrep -nf '(^|/)gpu-screen-recorder([[:space:]]|$)' 2>/dev/null || true)"
	[[ "$pid" =~ ^[0-9]+$ ]] || return 1
	starttime="$(process_starttime "$pid")" || return 1
	printf '%s %s\n' "$pid" "$starttime"
}

write_state() {
	local dnd=$1 bar_visible=$2 caffeine=$3 power_profile=$4 power_changed=$5 started_recording=$6
	local recording_pid=$7 recording_starttime=$8 mode=$9 temporary
	mkdir -p -- "$state_root"
	chmod 700 "$state_root"
	temporary="$(mktemp "$state_root/state.XXXXXX")"
	printf 'dnd=%s\nbar_visible=%s\ncaffeine=%s\npower_profile=%s\npower_changed=%s\nstarted_recording=%s\nrecording_pid=%s\nrecording_starttime=%s\nmode=%s\n' \
		"$dnd" "$bar_visible" "$caffeine" "$power_profile" "$power_changed" "$started_recording" \
		"$recording_pid" "$recording_starttime" "$mode" \
		>"$temporary"
	mv -f -- "$temporary" "$state_file"
}

state_value() {
	local key=$1 line
	[[ -f "$state_file" ]] || return 1
	line="$(awk -F= -v key="$key" '$1 == key { print $2; exit }' "$state_file")"
	case "$key:$line" in
	dnd:on | dnd:off | caffeine:on | caffeine:off | bar_visible:true | bar_visible:false | \
		power_changed:true | power_changed:false | started_recording:true | started_recording:false | \
		power_profile:performance | power_profile:balanced | power_profile:power-saver)
		printf '%s\n' "$line"
		;;
	recording_pid:* | recording_starttime:*)
		[[ "$line" =~ ^[0-9]+$ ]] || return 1
		printf '%s\n' "$line"
		;;
	mode:focus | mode:demo)
		printf '%s\n' "$line"
		;;
	*) return 1 ;;
	esac
}

state_mode() {
	local mode
	mode="$(state_value mode 2>/dev/null || true)"
	# Los estados creados por una versión anterior eran siempre modo foco.
	printf '%s\n' "${mode:-focus}"
}

recording_active() {
	recording_identity >/dev/null
}

wait_for_caffeine() {
	local expected=$1
	for _ in {1..20}; do
		[[ "$(read_caffeine 2>/dev/null || true)" == "$expected" ]] && return 0
		sleep 0.05
	done
	return 1
}

wait_for_power_profile() {
	local expected=$1
	for _ in {1..20}; do
		[[ "$(read_power_profile 2>/dev/null || true)" == "$expected" ]] && return 0
		sleep 0.05
	done
	return 1
}

enable_failed() {
	local message=$1
	disable_mode >/dev/null 2>&1 || true
	printf 'desktop-focus-mode: %s\n' "$message" >&2
	exit 1
}

enable_mode() {
	local demo=$1 dnd bar_visible caffeine power_profile power_changed=false started_recording=false
	local recording_pid=0 recording_starttime=0 identity mode=focus
	[[ "$demo" == true ]] && mode=demo
	[[ ! -e "$state_file" ]] || {
		printf '%s\n' 'El modo foco ya está activo.' >&2
		exit 1
	}

	dnd="$(noctalia msg notification-dnd-status)"
	[[ "$dnd" == on || "$dnd" == off ]] || {
		printf '%s\n' 'desktop-focus-mode: estado DND no válido.' >&2
		exit 1
	}
	bar_visible="$(read_bool barVisible)" || {
		printf '%s\n' 'desktop-focus-mode: no se pudo leer la barra de Noctalia.' >&2
		exit 1
	}
	caffeine="$(read_caffeine)" || {
		printf '%s\n' 'desktop-focus-mode: no se pudo leer el estado de cafeína.' >&2
		exit 1
	}
	power_profile="$(read_power_profile)" || {
		printf '%s\n' 'desktop-focus-mode: no se pudo leer el perfil de potencia.' >&2
		exit 1
	}
	if gaming_active; then
		printf '%s\n' 'desktop-focus-mode: hay una sesión gaming activa; usa game-run como propietario del estado.' >&2
		exit 1
	fi

	# Persistir primero permite que `off` restaure el host incluso si una acción
	# posterior falla o se interrumpe.
	write_state "$dnd" "$bar_visible" "$caffeine" "$power_profile" "$power_changed" "$started_recording" \
		"$recording_pid" "$recording_starttime" "$mode"

	if [[ "$caffeine" == off ]]; then
		noctalia msg caffeine-enable >/dev/null || enable_failed 'no se pudo activar cafeína.'
		wait_for_caffeine on || enable_failed 'cafeína no llegó al estado activo.'
	fi
	if [[ "$power_profile" != performance ]]; then
		power_changed=true
		write_state "$dnd" "$bar_visible" "$caffeine" "$power_profile" "$power_changed" "$started_recording" \
			"$recording_pid" "$recording_starttime" "$mode"
		noctalia msg power-set performance >/dev/null || enable_failed 'no se pudo activar performance.'
		wait_for_power_profile performance || enable_failed 'el perfil performance no llegó a activarse.'
	fi

	if [[ "$dnd" == off ]]; then
		noctalia msg notification-dnd-set on >/dev/null || enable_failed 'no se pudo activar DND.'
	fi
	if [[ "$demo" == false && "$bar_visible" == true ]]; then
		noctalia msg bar-hide >/dev/null || enable_failed 'no se pudo ocultar la barra.'
	elif [[ "$demo" == true && "$bar_visible" == false ]]; then
		noctalia msg bar-show >/dev/null || enable_failed 'no se pudo mostrar el indicador de grabación.'
	fi

	if [[ "$demo" == true ]] && ! recording_active; then
		if noctalia msg plugin noctalia/screen_recorder:service all start focused >/dev/null 2>&1; then
			for _ in {1..40}; do
				identity="$(recording_identity 2>/dev/null || true)"
				[[ -n "$identity" ]] && break
				sleep 0.05
			done
			if [[ -z "$identity" ]]; then
				noctalia msg plugin noctalia/screen_recorder:service all stop >/dev/null 2>&1 || true
				enable_failed 'la grabación no llegó al estado activo.'
			fi
			read -r recording_pid recording_starttime <<<"$identity"
			started_recording=true
			write_state "$dnd" "$bar_visible" "$caffeine" "$power_profile" "$power_changed" "$started_recording" \
				"$recording_pid" "$recording_starttime" "$mode"
		else
			enable_failed 'no se pudo iniciar la grabación.'
		fi
	fi
}

disable_mode() {
	local dnd bar_visible caffeine power_profile power_changed started_recording
	local recording_pid recording_starttime mode restore_failed=false
	[[ -f "$state_file" ]] || {
		printf '%s\n' 'El modo foco no está activo.' >&2
		exit 1
	}
	dnd="$(state_value dnd)" || exit 1
	bar_visible="$(state_value bar_visible)" || exit 1
	caffeine="$(state_value caffeine)" || exit 1
	power_profile="$(state_value power_profile)" || exit 1
	power_changed="$(state_value power_changed)" || exit 1
	started_recording="$(state_value started_recording)" || exit 1
	recording_pid="$(state_value recording_pid)" || exit 1
	recording_starttime="$(state_value recording_starttime)" || exit 1
	mode="$(state_mode)"

	if [[ "$started_recording" == true &&
		"$(process_starttime "$recording_pid" 2>/dev/null || true)" == "$recording_starttime" ]]; then
		noctalia msg plugin noctalia/screen_recorder:service all stop >/dev/null 2>&1 || restore_failed=true
	fi
	if [[ "$mode" == focus && "$bar_visible" == true ]]; then
		noctalia msg bar-show >/dev/null || restore_failed=true
	elif [[ "$mode" == demo && "$bar_visible" == false ]]; then
		noctalia msg bar-hide >/dev/null || restore_failed=true
	fi
	if [[ "$dnd" == off ]]; then
		noctalia msg notification-dnd-set off >/dev/null || restore_failed=true
	fi
	if [[ "$power_changed" == true ]]; then
		noctalia msg power-set "$power_profile" >/dev/null || restore_failed=true
	fi
	if [[ "$caffeine" == off ]]; then
		noctalia msg caffeine-disable >/dev/null || restore_failed=true
	fi
	if [[ "$restore_failed" == true ]]; then
		printf '%s\n' 'desktop-focus-mode: no se pudo restaurar todo el estado; se conserva el archivo para reintentar.' >&2
		return 1
	fi
	rm -f -- "$state_file"
}

require_noctalia
command -v jq >/dev/null 2>&1 || {
	printf '%s\n' 'desktop-focus-mode: jq no está disponible.' >&2
	exit 127
}
command -v systemd-inhibit >/dev/null 2>&1 || {
	printf '%s\n' 'desktop-focus-mode: systemd-inhibit no está disponible.' >&2
	exit 127
}
command -v powerprofilesctl >/dev/null 2>&1 || {
	printf '%s\n' 'desktop-focus-mode: powerprofilesctl no está disponible.' >&2
	exit 127
}

action=${1:-toggle}
[[ $# -le 1 ]] || {
	usage >&2
	exit 2
}

case "$action" in
status)
	[[ -f "$state_file" ]] && printf '%s\n' 'on' || printf '%s\n' 'off'
	;;
on) enable_mode false ;;
demo) enable_mode true ;;
off) disable_mode ;;
toggle)
	if [[ -f "$state_file" ]]; then
		disable_mode
	else
		enable_mode false
	fi
	;;
demo-toggle)
	if [[ -f "$state_file" ]]; then
		if [[ "$(state_mode)" == demo ]]; then
			disable_mode
		else
			printf '%s\n' 'El modo foco está activo; desactívalo con Hyper+I antes de iniciar una demo.' >&2
			exit 1
		fi
	else
		enable_mode true
	fi
	;;
--help | -h) usage ;;
*)
	usage >&2
	exit 2
	;;
esac
