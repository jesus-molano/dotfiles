#!/usr/bin/env bash
set -euo pipefail

usage() {
	printf '%s\n' 'Uso: dev-pulse-status [--json]'
}

json=false
while (($#)); do
	case "$1" in
	--json) json=true ;;
	--help | -h)
		usage
		exit 0
		;;
	*)
		usage >&2
		exit 2
		;;
	esac
	shift
done

git_root_for_directory() {
	local directory=$1
	timeout 1s env GIT_OPTIONAL_LOCKS=0 \
		git -C "$directory" rev-parse --show-toplevel 2>/dev/null
}

find_active_root() {
	local pid current directory root children_file child
	local inspected=0
	local -a queue=() child_pids=()
	local -A seen_directories=()

	if [[ -n "${DEV_PULSE_PROJECT_DIR:-}" ]]; then
		directory="$(readlink -f -- "$DEV_PULSE_PROJECT_DIR" 2>/dev/null || true)"
		if [[ -n "$directory" ]]; then
			git_root_for_directory "$directory" || true
		fi
		return
	fi

	command -v hyprctl >/dev/null 2>&1 || return 0
	command -v jq >/dev/null 2>&1 || return 0
	pid="$(hyprctl -j activewindow 2>/dev/null | jq -r '.pid // empty' 2>/dev/null || true)"
	[[ "$pid" =~ ^[0-9]+$ ]] || return 0

	queue=("$pid")
	while ((${#queue[@]} > 0 && inspected < 64)); do
		current=${queue[0]}
		queue=("${queue[@]:1}")
		((inspected += 1))

		directory="$(readlink -f -- "/proc/$current/cwd" 2>/dev/null || true)"
		if [[ -n "$directory" && -z "${seen_directories[$directory]+x}" ]]; then
			seen_directories["$directory"]=1
			if root="$(git_root_for_directory "$directory")"; then
				printf '%s\n' "$root"
				return
			fi
		fi

		# GUI terminals can spawn the shell from a worker thread. Linux records
		# those children under that thread, not necessarily under the main task.
		for children_file in "/proc/$current/task/"*/children; do
			[[ -r "$children_file" ]] || continue
			child_pids=()
			IFS=' ' read -r -a child_pids <"$children_file" || true
			for child in "${child_pids[@]}"; do
				[[ "$child" =~ ^[0-9]+$ ]] && queue+=("$child")
			done
		done
	done
}

count_processes() {
	local name=$1 count
	count="$(pgrep -cx -- "$name" 2>/dev/null || true)"
	[[ "$count" =~ ^[0-9]+$ ]] && printf '%s\n' "$count" || printf '0\n'
}

project=''
branch=''
dirty=0
dirty_available=false
root="$(find_active_root)"

if [[ -n "$root" ]]; then
	project="$(basename -- "$root")"
	branch="$(timeout 1s git -C "$root" symbolic-ref --quiet --short HEAD 2>/dev/null ||
		timeout 1s git -C "$root" rev-parse --short HEAD)"
	if status_output="$(timeout 2s env GIT_OPTIONAL_LOCKS=0 \
		git -C "$root" status --porcelain=v1 --untracked-files=normal 2>/dev/null)"; then
		if [[ -n "$status_output" ]]; then
			dirty="$(printf '%s\n' "$status_output" | awk 'END { print NR + 0 }')"
		else
			dirty=0
		fi
		dirty_available=true
	fi
fi

codex="$(count_processes codex)"
orca="$(count_processes orca-ide)"
available=false
[[ -n "$root" ]] && available=true

if [[ "$json" == true ]]; then
	command -v jq >/dev/null 2>&1 || {
		printf '%s\n' 'dev-pulse-status: jq es necesario para --json.' >&2
		exit 127
	}
	exec jq -cn \
		--arg project "$project" \
		--arg path "$root" \
		--arg branch "$branch" \
		--argjson dirty "$dirty" \
		--argjson dirty_available "$dirty_available" \
		--argjson codex "$codex" \
		--argjson orca "$orca" \
		--argjson available "$available" \
		'{project: $project, path: $path, branch: $branch, dirty: $dirty, dirty_available: $dirty_available, codex: $codex, orca: $orca, available: $available}'
fi

if [[ "$available" == true ]]; then
	if [[ "$dirty_available" == true ]]; then
		printf '%s\n' "$project · $branch · cambios:$dirty · codex:$codex"
	else
		printf '%s\n' "$project · $branch · cambios:? · codex:$codex"
	fi
else
	printf '%s\n' "Sin proyecto activo · codex:$codex"
fi
