{
  "manifest_version": 2,
  "name": "Project Atlas Dynamic Theme",
  "description": "Sincroniza los colores de Thunderbird con la paleta activa de Noctalia.",
  "version": "1.0.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "project-atlas-theme@local",
      "strict_min_version": "148.0"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": ["nativeMessaging", "theme"]
}
