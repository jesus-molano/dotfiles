[Desktop Entry]
Name=ChatGPT Community
Comment=ChatGPT y Codex para Linux
Exec=env CODEX_LINUX_DISABLE_USAGE_REPORTING=1 CHROME_DESKTOP=codex-desktop.desktop /usr/bin/codex-desktop %u
TryExec=/usr/bin/codex-desktop
Icon=codex-desktop
Terminal=false
Type=Application
Categories=Development;
MimeType=x-scheme-handler/codex;x-scheme-handler/codex-browser-sidebar;
Keywords=chatgpt;codex;openai;ai;coding;
StartupNotify=true
StartupWMClass=codex-desktop
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=env CODEX_LINUX_DISABLE_USAGE_REPORTING=1 CHROME_DESKTOP=codex-desktop.desktop CODEX_MULTI_LAUNCH=1 /usr/bin/codex-desktop --new-instance
