#!/usr/bin/env bash
# RGB reactivo opcional. Solo controla iluminación; nunca PWM ni ventiladores.
set -euo pipefail

readonly config_file="${XDG_CONFIG_HOME:-$HOME/.config}/reactive-rgb/config.conf"
readonly state_dir="${REACTIVE_RGB_RUNTIME_DIR:-${XDG_RUNTIME_DIR:-/tmp}/reactive-rgb-${UID:-$(id -u)}}"
readonly hwmon_root="${REACTIVE_RGB_HWMON_ROOT:-/sys/class/hwmon}"

enabled=0
ambient_color=4C7899
openrgb_device=''
nzxt_device=''
openrgb_zone=1
openrgb_zone_size=60
cpu_led_count=12
static_color=FFFFFF
cpu_green_threshold=50
cpu_orange_threshold=70
cpu_red_threshold=85
gpu_green_threshold=50
gpu_orange_threshold=70
gpu_red_threshold=83
interval=5
debounce=2
hysteresis=2
reapply_interval=300
mode=thermal
write_state=1
resolved_openrgb_device_cache=''
openrgb_device_resolved=0
resolved_nzxt_device_cache=''
nzxt_device_resolved=0
openrgb_devices_cache=''
openrgb_devices_loaded=0
cycle_applied=0
hardware_verified=0

usage() {
	printf '%s\n' \
		'Uso: reactive-rgb {status|detect|health|dry-run|run-once|run} [--mode MODO]' \
		'Modos: ambient, thermal, gaming, recording, build-pass, build-fail' \
		"Configuración: $config_file"
}

valid_color() { [[ "$1" =~ ^[[:xdigit:]]{6}$ ]]; }
valid_mode() {
	case "$1" in
	ambient | thermal | gaming | recording | build-pass | build-fail) return 0 ;;
	esac
	return 1
}

# Lee solo claves conocidas. El archivo no se evalúa como código shell.
read_config() {
	[[ -r "$config_file" ]] || return 0
	local line key value
	while IFS= read -r line || [[ -n "$line" ]]; do
		[[ -z "$line" || "$line" == \#* ]] && continue
		IFS='=' read -r key value <<<"$line"
		case "$key" in
		REACTIVE_RGB_ENABLED) [[ "$value" == 1 ]] && enabled=1 ;;
		REACTIVE_RGB_MODE) valid_mode "$value" && mode=$value ;;
		REACTIVE_RGB_AMBIENT_COLOR) valid_color "$value" && ambient_color=${value^^} ;;
		REACTIVE_RGB_OPENRGB_DEVICE) openrgb_device=$value ;;
		REACTIVE_RGB_NZXT_DEVICE) nzxt_device=$value ;;
		REACTIVE_RGB_STATIC_COLOR) valid_color "$value" && static_color=${value^^} ;;
		REACTIVE_RGB_OPENRGB_ZONE)
			[[ "$value" =~ ^[0-9]+$ ]] && ((value >= 0 && value <= 99)) && openrgb_zone=$value
			;;
		REACTIVE_RGB_OPENRGB_ZONE_SIZE)
			[[ "$value" =~ ^[0-9]+$ ]] && ((value >= 1 && value <= 999)) && openrgb_zone_size=$value
			;;
		REACTIVE_RGB_CPU_LED_COUNT)
			[[ "$value" =~ ^[0-9]+$ ]] && ((value >= 1 && value <= 998)) && cpu_led_count=$value
			;;
		REACTIVE_RGB_CPU_GREEN_THRESHOLD) [[ "$value" =~ ^[0-9]+$ ]] && ((value >= 1 && value <= 150)) && cpu_green_threshold=$value ;;
		REACTIVE_RGB_CPU_ORANGE_THRESHOLD) [[ "$value" =~ ^[0-9]+$ ]] && ((value >= 1 && value <= 150)) && cpu_orange_threshold=$value ;;
		REACTIVE_RGB_CPU_RED_THRESHOLD) [[ "$value" =~ ^[0-9]+$ ]] && ((value >= 1 && value <= 150)) && cpu_red_threshold=$value ;;
		REACTIVE_RGB_GPU_GREEN_THRESHOLD) [[ "$value" =~ ^[0-9]+$ ]] && ((value >= 1 && value <= 150)) && gpu_green_threshold=$value ;;
		REACTIVE_RGB_GPU_ORANGE_THRESHOLD) [[ "$value" =~ ^[0-9]+$ ]] && ((value >= 1 && value <= 150)) && gpu_orange_threshold=$value ;;
		REACTIVE_RGB_GPU_RED_THRESHOLD) [[ "$value" =~ ^[0-9]+$ ]] && ((value >= 1 && value <= 150)) && gpu_red_threshold=$value ;;
		REACTIVE_RGB_INTERVAL)
			[[ "$value" =~ ^[0-9]+$ ]] && ((value >= 1 && value <= 3600)) && interval=$value
			;;
		REACTIVE_RGB_DEBOUNCE)
			[[ "$value" =~ ^[0-9]+$ ]] && ((value >= 1 && value <= 20)) && debounce=$value
			;;
		REACTIVE_RGB_HYSTERESIS)
			[[ "$value" =~ ^[0-9]+$ ]] && ((value <= 15)) && hysteresis=$value
			;;
		REACTIVE_RGB_REAPPLY_INTERVAL)
			[[ "$value" =~ ^[0-9]+$ ]] && ((value >= 30 && value <= 3600)) && reapply_interval=$value
			;;
		esac
	done <"$config_file"
}

valid_thermal_thresholds() {
	((cpu_green_threshold < cpu_orange_threshold && cpu_orange_threshold < cpu_red_threshold &&
		gpu_green_threshold < gpu_orange_threshold && gpu_orange_threshold < gpu_red_threshold))
}

openrgb_available() { command -v openrgb >/dev/null 2>&1; }

openrgb_devices() {
	if ((openrgb_devices_loaded)); then
		printf '%s\n' "$openrgb_devices_cache"
		return 0
	fi
	openrgb_devices_loaded=1
	openrgb_available || return 0
	openrgb_devices_cache=$(timeout 20s openrgb --noautoconnect --list-devices 2>/dev/null || true)
	printf '%s\n' "$openrgb_devices_cache"
}

# El nombre debe coincidir exactamente con la enumeración. Se resuelve una sola
# vez por proceso para impedir que un rebind cambie el destino durante `run`.
resolved_openrgb_device() {
	if ((openrgb_device_resolved)); then
		printf '%s\n' "$resolved_openrgb_device_cache"
		return 0
	fi
	openrgb_device_resolved=1
	[[ -n "$openrgb_device" ]] || return 0
	local available
	openrgb_devices >/dev/null
	available=$openrgb_devices_cache
	resolved_openrgb_device_cache=$(awk -F': ' -v expected="$openrgb_device" '
		$1 ~ /^[[:space:]]*[0-9]+$/ && $2 == expected {
			device_index=$1
			gsub(/[[:space:]]/, "", device_index)
			print device_index "\t" $2
			exit
		}
	' <<<"$available")
	printf '%s\n' "$resolved_openrgb_device_cache"
}

resolved_nzxt_device() {
	if ((nzxt_device_resolved)); then
		printf '%s\n' "$resolved_nzxt_device_cache"
		return 0
	fi
	nzxt_device_resolved=1
	[[ -n "$nzxt_device" ]] || return 0
	local available
	openrgb_devices >/dev/null
	available=$openrgb_devices_cache
	resolved_nzxt_device_cache=$(awk -F': ' -v expected="$nzxt_device" '
		$1 ~ /^[[:space:]]*[0-9]+$/ && $2 == expected {
			device_index=$1
			gsub(/[[:space:]]/, "", device_index)
			print device_index "\t" $2
			exit
		}
	' <<<"$available")
	printf '%s\n' "$resolved_nzxt_device_cache"
}

cpu_temp() {
	local name_file dir raw hottest='' sensor_name
	for name_file in "$hwmon_root"/*/name; do
		[[ -r "$name_file" ]] || continue
		sensor_name=$(<"$name_file")
		[[ "$sensor_name" == k10temp || "$sensor_name" == coretemp || "$sensor_name" == zenpower ]] || continue
		dir=$(dirname -- "$name_file")
		for input in "$dir"/temp*_input; do
			[[ -r "$input" ]] || continue
			raw=$(<"$input")
			[[ "$raw" =~ ^[0-9]+$ ]] || continue
			raw=$((raw / 1000))
			[[ -z "$hottest" || $raw -gt $hottest ]] && hottest=$raw
		done
	done
	[[ -n "$hottest" ]] && printf '%s\n' "$hottest"
}

gpu_temp() {
	local raw='' nvidia_timeout=${REACTIVE_RGB_NVIDIA_TIMEOUT:-5}
	if command -v nvidia-smi >/dev/null 2>&1; then
		[[ "$nvidia_timeout" =~ ^[0-9]+([.][0-9]+)?$ ]] || nvidia_timeout=5
		raw=$(timeout "$nvidia_timeout" nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits 2>/dev/null |
			head -n 1 | tr -d '[:space:]')
		if [[ "$raw" =~ ^[0-9]+$ ]]; then
			printf '%s\n' "$raw"
			return 0
		fi
	fi
	local name_file dir input sensor_name hottest=''
	for name_file in "$hwmon_root"/*/name; do
		[[ -r "$name_file" ]] || continue
		sensor_name=$(<"$name_file")
		[[ "$sensor_name" == amdgpu || "$sensor_name" == i915 || "$sensor_name" == xe || "$sensor_name" == nouveau ]] || continue
		dir=$(dirname -- "$name_file")
		for input in "$dir"/temp*_input; do
			[[ -r "$input" ]] || continue
			raw=$(<"$input")
			[[ "$raw" =~ ^[0-9]+$ ]] || continue
			raw=$((raw / 1000))
			[[ -z "$hottest" || $raw -gt $hottest ]] && hottest=$raw
		done
	done
	[[ -n "$hottest" ]] && printf '%s\n' "$hottest"
}

max_temp() {
	local cpu='' gpu=''
	cpu=$(cpu_temp 2>/dev/null || true)
	gpu=$(gpu_temp 2>/dev/null || true)
	if [[ "$cpu" =~ ^[0-9]+$ && "$gpu" =~ ^[0-9]+$ ]]; then
		((cpu > gpu)) && printf '%s\n' "$cpu" || printf '%s\n' "$gpu"
	elif [[ "$cpu" =~ ^[0-9]+$ ]]; then
		printf '%s\n' "$cpu"
	elif [[ "$gpu" =~ ^[0-9]+$ ]]; then
		printf '%s\n' "$gpu"
	else
		return 1
	fi
}

base_thermal_band() {
	local sensor=$1 temperature=$2 green orange red
	case "$sensor" in
	cpu) green=$cpu_green_threshold; orange=$cpu_orange_threshold; red=$cpu_red_threshold ;;
	gpu) green=$gpu_green_threshold; orange=$gpu_orange_threshold; red=$gpu_red_threshold ;;
	*) return 1 ;;
	esac
	if ((temperature < green)); then
		printf cool
	elif ((temperature < orange)); then
		printf normal
	elif ((temperature < red)); then
		printf warm
	else
		printf critical
	fi
}

thermal_band() {
	local sensor=$1 temperature=$2 previous=${3:-} green orange red
	case "$sensor" in
	cpu) green=$cpu_green_threshold; orange=$cpu_orange_threshold; red=$cpu_red_threshold ;;
	gpu) green=$gpu_green_threshold; orange=$gpu_orange_threshold; red=$gpu_red_threshold ;;
	*) return 1 ;;
	esac
	case "$previous" in
	cool) ((temperature < green + hysteresis)) && { printf cool; return; } ;;
	normal)
		((temperature < green - hysteresis)) && { base_thermal_band "$sensor" "$temperature"; return; }
		((temperature < orange + hysteresis)) && { printf normal; return; }
		;;
	warm)
		((temperature < orange - hysteresis)) && { base_thermal_band "$sensor" "$temperature"; return; }
		((temperature < red + hysteresis)) && { printf warm; return; }
		;;
	critical)
		((temperature >= red - hysteresis)) && { printf critical; return; }
		;;
	esac
	base_thermal_band "$sensor" "$temperature"
}

color_for_band() {
	case "$1" in
	cool) printf '2080FF\n' ;;
	normal) printf '20D070\n' ;;
	warm | hot) printf 'FF4000\n' ;;
	critical) printf 'FF0000\n' ;;
	*) return 1 ;;
	esac
}

color_for_fixed_mode() {
	case "$mode" in
	ambient) printf '%s\n' "$ambient_color" ;;
	gaming) printf '00A8FF\n' ;;
	recording) printf 'FF2038\n' ;;
	build-pass) printf '20D070\n' ;;
	build-fail) printf 'FF3030\n' ;;
	*) return 1 ;;
	esac
}

# Imprime "cpu_color<TAB>gpu_color". En térmico cada segmento usa solamente
# su propio sensor; no se mezcla ni se usa la temperatura máxima.
colors_for_mode() {
	local cpu_temperature gpu_temperature cpu_previous='' gpu_previous='' cpu_band gpu_band cpu_color gpu_color fixed_color
	if [[ "$mode" != thermal ]]; then
		fixed_color=$(color_for_fixed_mode) || return 1
		printf '%s\t%s\n' "$fixed_color" "$fixed_color"
		return 0
	fi
	cpu_temperature=$(cpu_temp) || return 1
	gpu_temperature=$(gpu_temp) || return 1
	[[ -r "$state_dir/cpu-band" ]] && cpu_previous=$(<"$state_dir/cpu-band")
	[[ -r "$state_dir/gpu-band" ]] && gpu_previous=$(<"$state_dir/gpu-band")
	cpu_band=$(thermal_band cpu "$cpu_temperature" "$cpu_previous")
	gpu_band=$(thermal_band gpu "$gpu_temperature" "$gpu_previous")
	cpu_color=$(color_for_band "$cpu_band")
	gpu_color=$(color_for_band "$gpu_band")
	if [[ $write_state -eq 1 ]]; then
		printf '%s\n' "$cpu_band" >"$state_dir/cpu-band"
		printf '%s\n' "$gpu_band" >"$state_dir/gpu-band"
	fi
	printf '%s\t%s\n' "$cpu_color" "$gpu_color"
}

# Devuelve el color estable de un segmento. Mientras el nuevo color no supera
# el debounce conserva el color aplicado; los dos segmentos hacen esto aparte.
debounced_color() {
	local segment=$1 desired=$2 current=$3 pending='' count=0
	if [[ -n "$current" && "$desired" == "$current" ]]; then
		rm -f -- "$state_dir/$segment-pending" "$state_dir/$segment-pending-count"
		printf '%s\n' "$current"
		return 0
	fi
	pending=$(cat -- "$state_dir/$segment-pending" 2>/dev/null || true)
	if [[ "$pending" == "$desired" ]]; then
		count=$(cat -- "$state_dir/$segment-pending-count" 2>/dev/null || printf 0)
	fi
	count=$((count + 1))
	printf '%s\n' "$desired" >"$state_dir/$segment-pending"
	printf '%s\n' "$count" >"$state_dir/$segment-pending-count"
	if ((count < debounce)); then
		printf '%s\n' "$current"
		return 1
	fi
	rm -f -- "$state_dir/$segment-pending" "$state_dir/$segment-pending-count"
	printf '%s\n' "$desired"
}

apply_color() {
	local cpu_color=$1 gpu_color=$2 index device nzxt_index nzxt color_values='' led
	local -a openrgb_command
	((cpu_led_count >= 1 && cpu_led_count < openrgb_zone_size)) || {
		printf 'Reactive RGB: CPU_LED_COUNT debe estar entre 1 y zona-1.\n' >&2
		return 1
	}
	resolved_openrgb_device >/dev/null
	IFS=$'\t' read -r index device <<<"$resolved_openrgb_device_cache"
	[[ -n "$index" && -n "$device" ]] || {
		printf 'Reactive RGB: no se encontró el dispositivo OpenRGB exacto: %s.\n' "$openrgb_device" >&2
		return 1
	}
	resolved_nzxt_device >/dev/null
	IFS=$'\t' read -r nzxt_index nzxt <<<"$resolved_nzxt_device_cache"
	[[ -n "$nzxt_index" && -n "$nzxt" ]] || {
		printf 'Reactive RGB: no se encontró el dispositivo OpenRGB exacto: %s.\n' "$nzxt_device" >&2
		return 1
	}
	for ((led = 1; led <= cpu_led_count; led++)); do color_values+="${color_values:+,}$cpu_color"; done
	for ((led = cpu_led_count + 1; led <= openrgb_zone_size; led++)); do color_values+=",$gpu_color"; done
	# Aura Addressable 1 no informa sus LED. OpenRGB guarda el resize, pero lo
	# repetimos de forma idempotente en cada aplicación para sobrevivir reinicios.
	openrgb_command=(timeout 20s openrgb --noautoconnect
		--device "$device" --zone 0 --mode direct --color "$static_color"
		--device "$nzxt" --zone 0 --mode direct --color "$static_color"
		--device "$nzxt" --zone 1 --mode direct --color "$static_color"
		--device "$device" --zone "$openrgb_zone" --size "$openrgb_zone_size" --mode direct --color "$color_values")
	if ! "${openrgb_command[@]}" >/dev/null; then
		printf 'Reactive RGB: OpenRGB no pudo aplicar color a %s, zona %s.\n' "$device" "$openrgb_zone" >&2
		return 1
	fi
}

print_detection() {
	local temperature index device
	printf 'config=%s\nopt_in=%s\nmode=%s\n' "$config_file" "$enabled" "$mode"
	if temperature=$(max_temp 2>/dev/null); then
		printf 'temperature_c=%s\n' "$temperature"
	else
		printf '%s\n' 'temperature_c=unavailable'
	fi
	if openrgb_available; then
		printf '%s\n' 'openrgb=available'
		local index device nzxt_index nzxt
		resolved_openrgb_device >/dev/null
		IFS=$'\t' read -r index device <<<"$resolved_openrgb_device_cache"
		resolved_nzxt_device >/dev/null
		IFS=$'\t' read -r nzxt_index nzxt <<<"$resolved_nzxt_device_cache"
		[[ -n "$device" ]] && printf 'openrgb_target=%s:%s\nopenrgb_zone=%s\nopenrgb_zone_size=%s\ncpu_led_count=%s\n' \
			"$index" "$device" "$openrgb_zone" "$openrgb_zone_size" "$cpu_led_count"
		[[ -n "$nzxt" ]] && printf 'openrgb_static_nzxt=%s:%s\nopenrgb_static_color=%s\n' \
			"$nzxt_index" "$nzxt" "$static_color"
	else
		printf '%s\n' 'openrgb=missing'
	fi
}

dry_run() {
	local colors cpu_color gpu_color
	write_state=0
	colors=$(colors_for_mode) || {
		printf '%s\n' 'No hay temperatura CPU/GPU disponible.' >&2
		return 1
	}
	IFS=$'\t' read -r cpu_color gpu_color <<<"$colors"
	printf 'mode=%s\ncpu_color=%s\ngpu_color=%s\n' "$mode" "$cpu_color" "$gpu_color"
	print_detection
}

acquire_instance_lock() {
	install -d -m 700 -- "$state_dir"
	exec 9>"$state_dir/instance.lock"
	flock -n 9 || {
		printf '%s\n' 'Reactive RGB: otra instancia controla el hardware.' >&2
		return 75
	}
}

run_once() {
	cycle_applied=0
	[[ $enabled -eq 1 ]] || {
		printf 'Reactive RGB está desactivado en %s.\n' "$config_file" >&2
		return 3
	}
	[[ ${EUID:-$(id -u)} -ne 0 || ${REACTIVE_RGB_ALLOW_ROOT_FOR_TESTS:-0} == 1 ]] || {
		printf '%s\n' 'Reactive RGB no se ejecuta como root.' >&2
		return 4
	}
	install -d -m 700 -- "$state_dir"
	local colors desired_cpu_color desired_gpu_color current_cpu_color='' current_gpu_color='' cpu_color gpu_color cpu_stable=0 gpu_stable=0 last_applied_at=0 now
	colors=$(colors_for_mode) || {
		printf '%s\n' 'No hay temperatura CPU/GPU disponible.' >&2
		return 1
	}
	IFS=$'\t' read -r desired_cpu_color desired_gpu_color <<<"$colors"
	current_cpu_color=$(cat -- "$state_dir/cpu-color" 2>/dev/null || true)
	current_gpu_color=$(cat -- "$state_dir/gpu-color" 2>/dev/null || true)
	last_applied_at=$(cat -- "$state_dir/last-applied-at" 2>/dev/null || printf 0)
	[[ "$last_applied_at" =~ ^[0-9]+$ ]] || last_applied_at=0
	now=$(date +%s)
	if [[ "$current_cpu_color" == "$desired_cpu_color" && "$current_gpu_color" == "$desired_gpu_color" ]] && ((now - last_applied_at < reapply_interval)); then
		printf 'Sin cambio: CPU=%s GPU=%s\n' "$desired_cpu_color" "$desired_gpu_color"
		return 0
	fi
	if cpu_color=$(debounced_color cpu "$desired_cpu_color" "$current_cpu_color"); then cpu_stable=1; fi
	if gpu_color=$(debounced_color gpu "$desired_gpu_color" "$current_gpu_color"); then gpu_stable=1; fi
	if [[ -z "$cpu_color" || -z "$gpu_color" ]]; then
		printf 'Debounce: CPU=%s/%s GPU=%s/%s\n' "$cpu_stable" "$debounce" "$gpu_stable" "$debounce"
		return 0
	fi
	apply_color "$cpu_color" "$gpu_color" || {
		printf '%s\n' 'No hay destinos RGB seguros disponibles.' >&2
		return 1
	}
	printf '%s\n' "$cpu_color" >"$state_dir/cpu-color"
	printf '%s\n' "$gpu_color" >"$state_dir/gpu-color"
	printf '%s\n' "$now" >"$state_dir/last-applied-at"
	cycle_applied=1
	printf 'Aplicado: CPU=%s GPU=%s\n' "$cpu_color" "$gpu_color"
}

process_starttime() {
	local pid=$1 stat_line remainder
	local -a fields
	[[ "$pid" =~ ^[0-9]+$ && -r "/proc/$pid/stat" ]] || return 1
	stat_line=$(<"/proc/$pid/stat")
	remainder=${stat_line##*) }
	read -r -a fields <<<"$remainder"
	((${#fields[@]} >= 20)) && [[ "${fields[19]}" =~ ^[0-9]+$ ]] || return 1
	printf '%s\n' "${fields[19]}"
}

write_health() {
	local status=$1 failures=$2 temporary starttime last_applied_at=0
	starttime=$(process_starttime "$$") || return 1
	last_applied_at=$(cat -- "$state_dir/last-applied-at" 2>/dev/null || printf 0)
	[[ "$last_applied_at" =~ ^[0-9]+$ ]] || last_applied_at=0
	temporary=$(mktemp "$state_dir/.health.XXXXXX") || return 1
	{
		printf 'status=%s\n' "$status"
		printf '%s\n' 'scope=liveness-with-periodic-hardware-reapply'
		printf 'updated_at=%s\n' "$(date +%s)"
		printf 'last_applied_at=%s\n' "$last_applied_at"
		printf 'consecutive_failures=%s\n' "$failures"
		printf 'pid=%s\n' "$$"
		printf 'starttime=%s\n' "$starttime"
	} >"$temporary"
	mv -f -- "$temporary" "$state_dir/health"
}

print_health() {
	local line key value status='' scope='' updated_at='' last_applied_at='' failures='' pid='' starttime='' now age current_starttime freshness_limit
	[[ -r "$state_dir/health" ]] || return 1
	while IFS='=' read -r key value; do
		case "$key" in
		status) status=$value ;;
		scope) scope=$value ;;
		updated_at) updated_at=$value ;;
		last_applied_at) last_applied_at=$value ;;
		consecutive_failures) failures=$value ;;
		pid) pid=$value ;;
		starttime) starttime=$value ;;
		esac
	done <"$state_dir/health"
	[[ "$status" == starting || "$status" == ok || "$status" == error ]] || return 1
	[[ "$scope" == liveness-with-periodic-hardware-reapply ]] || return 1
	[[ "$updated_at" =~ ^[0-9]+$ && "$last_applied_at" =~ ^[0-9]+$ && "$failures" =~ ^[0-9]+$ && "$pid" =~ ^[0-9]+$ && "$starttime" =~ ^[0-9]+$ ]] || return 1
	now=$(date +%s)
	age=$((now - updated_at))
	((age >= 0)) || age=0
	current_starttime=$(process_starttime "$pid" 2>/dev/null || true)
	printf 'health_status=%s\nhealth_scope=%s\nhealth_updated_at=%s\nhealth_age_seconds=%s\nhealth_last_applied_at=%s\nhealth_consecutive_failures=%s\nhealth_pid=%s\n' \
		"$status" "$scope" "$updated_at" "$age" "$last_applied_at" "$failures" "$pid"
	freshness_limit=$((interval * 3 + 5))
	if [[ "$status" == ok && "$current_starttime" == "$starttime" && $age -le $freshness_limit ]]; then
		printf '%s\n' 'health_fresh=1'
	else
		printf '%s\n' 'health_fresh=0'
	fi
}

read_config
valid_thermal_thresholds || {
	printf '%s\n' 'Umbrales RGB inválidos: cada componente requiere verde < naranja < rojo.' >&2
	exit 2
}
command=${1:-status}
shift || true
while (($#)); do
	case "$1" in
	--mode)
		mode=${2:-}
		shift 2
		;;
	--help | -h)
		usage
		exit 0
		;;
	*) usage >&2; exit 2 ;;
	esac
done
valid_mode "$mode" || { printf 'Modo no válido: %s\n' "$mode" >&2; exit 2; }

case "$command" in
status | detect) print_detection ;;
health) print_health ;;
dry-run) dry_run ;;
run-once)
	acquire_instance_lock
	run_once
	;;
run)
	if ((enabled == 0)); then
		printf 'Reactive RGB está desactivado en %s; el servicio termina sin error.\n' "$config_file"
		exit 0
	fi
	acquire_instance_lock
	trap 'exit 0' INT TERM
	consecutive_failures=0
	install -d -m 700 -- "$state_dir"
	# El color persistido pertenece a otra instancia y no demuestra que esta
	# pueda hablar con el hardware. Cada arranque debe aplicar al menos una vez.
	rm -f -- "$state_dir/cpu-color" "$state_dir/gpu-color"
	write_health starting 0 || printf '%s\n' 'Reactive RGB: no pudo registrar el arranque.' >&2
	while :; do
		if run_once; then
			consecutive_failures=0
			((cycle_applied)) && hardware_verified=1
			if ((hardware_verified)); then
				write_health ok "$consecutive_failures" || printf '%s\n' 'Reactive RGB: no pudo registrar salud.' >&2
			fi
		else
			consecutive_failures=$((consecutive_failures + 1))
			write_health error "$consecutive_failures" || printf '%s\n' 'Reactive RGB: no pudo registrar salud.' >&2
			printf 'Reactive RGB: ciclo fallido (%s/3).\n' "$consecutive_failures" >&2
			if ((consecutive_failures >= 3)); then
				printf '%s\n' 'Reactive RGB: se detiene para permitir el reinicio del servicio.' >&2
				exit 1
			fi
		fi
		sleep "$interval"
	done
	;;
--help | -h) usage ;;
*) usage >&2; exit 2 ;;
esac
