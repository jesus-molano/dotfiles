#!/usr/bin/env bash

set -u

readonly card='alsa_card.pci-0000_07_00.1'
readonly profile='output:hdmi-stereo'
readonly sink='alsa_output.pci-0000_07_00.1.hdmi-stereo'

# PipeWire and the NVIDIA connector can appear shortly after Hyprland starts.
# Retry for up to 20 seconds; failing quietly leaves the current output intact.
for _ in {1..40}; do
	if ! pactl list short sinks 2>/dev/null | cut -f2 | grep -Fxq "$sink"; then
		pactl set-card-profile "$card" "$profile" 2>/dev/null || {
			sleep 0.5
			continue
		}
	fi

	if pactl list short sinks 2>/dev/null | cut -f2 | grep -Fxq "$sink"; then
		pactl set-default-sink "$sink" || exit 0
		target_id=$(pactl list short sinks | awk -v sink="$sink" '$2 == sink { print $1; exit }')

		# Streams opened before the HDMI endpoint was ready should follow it too.
		while read -r input_id current_sink_id _; do
			if [[ -n "$input_id" && "$current_sink_id" != "$target_id" ]]; then
				pactl move-sink-input "$input_id" "$sink" 2>/dev/null || true
			fi
		done < <(pactl list short sink-inputs 2>/dev/null)
		exit 0
	fi
	sleep 0.5
done

exit 0
